<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NeedleBase.Mobile.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Baseline EF Core SQLite (LocalDbContext + sync queue in Slice 4). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <!-- GHSA-2m69-gcr7-jv3q: EF Core Sqlite 9.0.9 pulls SQLitePCLRaw 2.1.10 (bundled SQLite with known CVEs, fixed
         in 2.1.12+). Pin the bundle so lib.e_sqlite3 (and lib.e_sqlite3.android in the app) resolve to 2.1.14. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeedleBase.Application\NeedleBase.Application.csproj" />
    <ProjectReference Include="..\NeedleBase.Domain\NeedleBase.Domain.csproj" />
  </ItemGroup>

</Project>
