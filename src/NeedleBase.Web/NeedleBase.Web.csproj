<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NeedleBase.Web</RootNamespace>
    <UserSecretsId>needlebase-web-dev-secrets</UserSecretsId>
    <!-- Shared hosting (MonsterASP free: 256 MB per website): workstation GC keeps the heap small;
         these apps serve small shops, so server GC's throughput is not needed. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeedleBase.Application\NeedleBase.Application.csproj" />
    <!-- One site, one process: the Web hosts the Api under /api (Api:InProcess, docs/deployment.md). -->
    <ProjectReference Include="..\NeedleBase.Api\NeedleBase.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeedleBase.Web.Tests" />
  </ItemGroup>

</Project>
