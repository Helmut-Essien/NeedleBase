@page
@model NeedleBase.Web.Pages.Activity.IndexModel
@using NeedleBase.Application.Audit
@{
    ViewData["Title"] = "Activity";
}
<h1 class="nb-page-title">Activity</h1>
<p class="nb-meta">Who changed what, and when. Times are Accra time.</p>

@if (Model.PageError is null || Model.Loaded)
{
<form method="get" class="nb-filters" role="search" aria-label="Filter activity">
    <div>
        <label for="who" class="form-label">Person</label>
        <select id="who" name="who" class="form-select">
            <option value="">Everyone</option>
            @if (!string.IsNullOrEmpty(Model.Who) && Model.Staff.All(s => s.UserId != Model.Who))
            {
                <option value="@Model.Who" selected>Former team member</option>
            }
            @foreach (var s in Model.Staff)
            {
                <option value="@s.UserId" selected="@(s.UserId == Model.Who)">@s.Name</option>
            }
        </select>
    </div>
    <div>
        <label for="kind" class="form-label">Kind</label>
        <select id="kind" name="kind" class="form-select">
            <option value="">Everything</option>
            @foreach (var (value, label) in Model.Groups)
            {
                <option value="@value" selected="@(value == Model.Kind)">@label</option>
            }
        </select>
    </div>
    <div>
        <label for="from" class="form-label">From</label>
        <input id="from" name="from" type="date" class="form-control" value="@Model.From" aria-describedby="@(Model.DateError is null ? null : "date-error")" />
    </div>
    <div>
        <label for="to" class="form-label">To</label>
        <input id="to" name="to" type="date" class="form-control" value="@Model.To" />
    </div>
    <div>
        <label for="q" class="form-label">Words</label>
        <input id="q" name="q" class="form-control" maxlength="100" value="@Model.Search" placeholder="e.g. #ORD-12, voided" />
    </div>
    @if (!string.IsNullOrEmpty(Model.OrderId)) { <input type="hidden" name="order" value="@Model.OrderId" /> }
    @if (!string.IsNullOrEmpty(Model.CustomerId)) { <input type="hidden" name="customer" value="@Model.CustomerId" /> }
    <div class="nb-filters__actions">
        <button type="submit" class="btn nb-btn-primary">Filter</button>
        @if (Model.Filtered)
        {
            <a class="btn nb-btn-outline" asp-page="/Activity/Index">Clear</a>
        }
    </div>
</form>
}
@if (Model.DateError is not null)
{
    <p id="date-error" class="text-danger small" role="alert">@Model.DateError Showing the dates the other way round.</p>
}
@if (!string.IsNullOrEmpty(Model.OrderId))
{
    <p class="nb-meta">Showing the history of one order. <a asp-page="/Orders/Details" asp-route-id="@Model.OrderId">Open the order</a></p>
}
@if (!string.IsNullOrEmpty(Model.CustomerId))
{
    <p class="nb-meta">Showing the history of one customer (their measurements, orders and payments).</p>
}
<partial name="_PageState" model="Model" />

@if (Model.Result is { } r)
{
    @if (Model.PastEnd)
    {
        <p class="nb-empty">This page is past the end of the list. <a href="@(new NeedleBase.Web.Pages.PagerModel("/Activity", 1, 1, 0, Model.Query()).Url(1))">Go to the first page</a>.</p>
    }
    else if (r.Data.Count == 0)
    {
        <p class="nb-empty">@(Model.Filtered ? "Nothing matches these filters." : "No activity yet. Changes made on the phones or here show up as they happen.")</p>
    }
    else
    {
        <ul class="nb-list nb-activity">
            @foreach (var e in r.Data)
            {
                <li>
                    <partial name="_ActivityItem" model="e" />
                </li>
            }
        </ul>
        <partial name="_Pager" model="Model.Pager" />
    }
}
