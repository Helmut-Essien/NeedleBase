@page
@model NeedleBase.Web.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}
<h1 class="nb-page-title">Payments</h1>
<p class="nb-meta">Payments recorded in the NeedleBase app. NeedleBase records payments; it doesn't process Mobile Money.</p>
<partial name="_PageState" model="Model" />
@if (Model.Result is { } r)
{
    @if (r.Data.Count == 0 && r.TotalCount > 0)
    {
        <p class="nb-empty">This page is past the end of the list. <a asp-page="/Payments/Index">Go to the first page</a>.</p>
    }
    else if (r.Data.Count == 0)
    {
        <p class="nb-empty">No payments recorded yet. Record a payment from an order in the NeedleBase app.</p>
    }
    else
    {
        <table class="table nb-table nb-table--cards">
            <caption class="visually-hidden">Payments, newest first</caption>
            <thead><tr><th scope="col">Date</th><th scope="col">Customer</th><th scope="col">Order</th><th scope="col" class="d-none d-md-table-cell">Method</th><th scope="col" class="text-end">Amount</th></tr></thead>
            <tbody>
                @foreach (var p in r.Data)
                {
                    <tr>
                        <td data-label="Date">@p.RecordedDisplay</td>
                        <td data-label="Customer">@p.CustomerName</td>
                        <td data-label="Order"><a asp-page="/Orders/Details" asp-route-id="@p.OrderId">#@p.OrderDisplayRef</a></td>
                        <td data-label="Method" class="d-none d-md-table-cell">@p.Method payment recorded</td>
                        <td data-label="Amount" class="text-end nb-money @(p.IsVoided ? "nb-voided" : "")">@p.AmountDisplay@(p.IsVoided ? " · Voided" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
        <partial name="_Pager" model="Model.Pager" />
    }
}
