@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="nb-card nb-error">
<span class="nb-empty__icon" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></span>
<h1 class="nb-page-title">@Model.Heading</h1>
<p class="lead">@Model.Body</p>
<p><a class="btn nb-btn-primary" href="/">Go to the dashboard</a></p>
</div>

@if (Model.ShowRequestId)
{
    <p class="nb-meta">
        <strong>Reference:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (Model.ShowDevelopmentHints)
{
    <div class="mt-4 p-3 border rounded nb-surface-box">
        <h2 class="h5">Development tips</h2>
        <p class="mb-0">
            Set <code>ASPNETCORE_ENVIRONMENT=Development</code> locally to see detailed exception pages.
            Never enable Development on deployed hosts.
        </p>
    </div>
}
