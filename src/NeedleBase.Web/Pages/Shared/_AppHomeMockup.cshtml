                                    </div>
                                    <div class="lp-home__attn">
                                        <span class="lp-home__attn-av">K</span>
                                        <span class="lp-home__attn-copy">
                                            <span class="lp-home__attn-name">Kofi</span>
                                            <span class="lp-home__attn-detail">#C4Q9M2TW · 10 Nov 2026</span>
                                        </span>
                                        <span class="lp-home__badge lp-home__badge--ready"><svg class="lp-home__ico lp-home__ico--check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg><span>Ready to collect</span></span>
