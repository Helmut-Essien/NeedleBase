@model NeedleBase.Web.Pages.Shared.PasswordToggleModel
<button type="button"
        class="nb-password-toggle"
        data-input-id="@Model.InputId"
        data-show-label="@Model.ShowLabel"
        data-hide-label="@Model.HideLabel"
        aria-label="@Model.ShowLabel"
        aria-pressed="false"
        aria-controls="@Model.InputId">
    <svg class="nb-password-toggle__icon nb-password-toggle__icon--show" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" />
        <circle cx="12" cy="12" r="3" />
    </svg>
    <svg class="nb-password-toggle__icon nb-password-toggle__icon--hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 3l18 18" />
        <path d="M10.58 10.58A3 3 0 0 0 13.42 13.42" />
        <path d="M9.88 5.53A9.36 9.36 0 0 1 12 5.25c6 0 9.75 6.75 9.75 6.75a17.7 17.7 0 0 1-2.94 3.72" />
        <path d="M6.61 6.61C3.83 8.43 2.25 12 2.25 12S6 18.75 12 18.75a9.5 9.5 0 0 0 4.46-1.12" />
    </svg>
</button>
