<!DOCTYPE html>
<html lang="en-GH">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeedleBase</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NeedleBase.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @using NeedleBase.Web.Services
    <a class="skip-link" href="#main-content">Skip to main content</a>
    @* Below md (768px): top bar with a collapsible menu. From md up: persistent left sidebar. *@
    <header class="d-md-none">
        <nav class="navbar nb-navbar" aria-label="Primary">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">NeedleBase</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nb-mobile-nav"
                            aria-controls="nb-mobile-nav" aria-expanded="false" aria-label="Open menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="nb-mobile-nav">
                        <partial name="_NavLinks" />
                        <div class="nb-nav-foot">
                            <span class="nb-nav-user">@User.DisplayName() · @User.BusinessName()</span>
                            <form asp-page="/Account/Logout" method="post"><button type="submit" class="btn btn-sm nb-btn-outline">Sign out</button></form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="nb-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="nb-sidebar d-none d-md-flex" aria-label="Primary">
                <a class="nb-sidebar__brand" asp-page="/Index">NeedleBase</a>
                <span class="nb-sidebar__business">@User.BusinessName()</span>
                <partial name="_NavLinks" />
                <div class="nb-nav-foot mt-auto">
                    <span class="nb-nav-user">@User.DisplayName()</span>
                    <form asp-page="/Account/Logout" method="post"><button type="submit" class="btn btn-sm nb-btn-outline">Sign out</button></form>
                </div>
            </aside>
        }
        <div class="nb-content">
            <main id="main-content" role="main" class="nb-main" tabindex="-1">
                @RenderBody()
            </main>
            <footer class="nb-footer">
                <div class="py-3">
                    &copy; 2026 - NeedleBase (HelmutCode)
                    <nav class="nb-footer-links" aria-label="Legal">
                        <a asp-page="/Terms">Terms and Conditions</a>
                        <span aria-hidden="true">·</span>
                        <a asp-page="/Privacy">Privacy Policy</a>
                    </nav>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
