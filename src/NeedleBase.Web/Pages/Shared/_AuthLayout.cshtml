<!DOCTYPE html>
<html lang="en-GH">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeedleBase</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="nb-auth-body">
    <a class="visually-hidden-focusable skip-link" href="#auth-main">Skip to content</a>
    <main id="auth-main" class="nb-auth-shell">
        <div class="nb-auth-card">
            <div class="nb-auth-brand" role="banner">NeedleBase</div>
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
