<!DOCTYPE html>
<html lang="en-GH">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeedleBase</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="nb-auth-body">
    <a class="visually-hidden-focusable skip-link" href="#auth-main">Skip to content</a>
    <main id="auth-main" class="nb-auth-shell">
        <div class="nb-auth-card">
            <div class="nb-auth-brand">
                <img src="~/images/needlebase-logo.png"
                     asp-append-version="true"
                     alt="NeedleBase"
                     class="nb-auth-logo"
                     width="340"
                     height="188" />
            </div>
            @RenderBody()
        </div>

    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
