@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="nb-hero text-center">
    <h1 class="display-5">NeedleBase</h1>
    <p class="lead">Tailoring business management — web oversight.</p>
    <p class="nb-meta mb-2">API base: <code>@Model.ApiBaseUrl</code></p>
    <p class="mb-0" role="status" aria-live="polite">
        <span class="visually-hidden">API health: </span>
        @if (Model.ApiReachable)
        {
            <span class="nb-status nb-status--ok">● Reachable (@Model.ApiHealthStatus)</span>
        }
        else
        {
            <span class="nb-status nb-status--warn">● Unreachable — start the Api process</span>
        }
    </p>
</div>
