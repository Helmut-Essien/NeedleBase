@page
@model NeedleBase.Web.Pages.IndexModel
@using NeedleBase.Web.Marketing
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = "NeedleBase — Tailoring shop software for Ghana & West Africa";
    ViewData["MetaDescription"] = "NeedleBase keeps customers, measurements, orders and payments in one place, even without data. Start free on your phone.";
    ViewData["Canonical"] = Model.CanonicalUrl;
    ViewData["OgImage"] = Model.OgImageUrl;
    ViewData["CspNonce"] = Model.CspNonce;
    ViewData["PreloadHero"] = true;
    var origin = Model.SiteOrigin ?? "";
    var download = "/download";
    var wa = Model.WhatsAppUrl;
    var paidWa = LandingSalesInfo.WhatsAppUrlForPaidPlan();
    var helpWa = LandingSalesInfo.WhatsAppHelpUrl();
    var feedbackWa = LandingSalesInfo.WhatsAppFeedbackUrl();
    var feedbackMail = LandingSalesInfo.MailtoFeedbackUrl();
    var mail = Model.MailtoUrl;
    string Srcset(string stem, string ext, params int[] widths) =>
        string.Join(", ", widths.Select(w => $"/img/landing/{stem}-{w}.{ext} {w}w"));
}
<header class="lp-nav" role="banner" data-lp-drawer-outside>
    <a class="lp-nav__brand" href="#top" aria-label="NeedleBase home — software for tailors and fashion workshops">
        <span class="lp-brand">
            <picture>
                <source type="image/webp" srcset="/images/needlebase-logo-nav.webp" />
                <img class="lp-brand__logo" src="~/images/needlebase-logo-nav.png" asp-append-version="true"
                     width="390" height="82" alt="NeedleBase — tailor and fashion workshop software" decoding="async" />
            </picture>
        </span>
    </a>
    <nav class="lp-nav__links" aria-label="Landing">
        <a href="#problems" data-lp-nav-link>Why NeedleBase</a>
        <a href="#how" data-lp-nav-link>How it works</a>
        <a href="#pricing" data-lp-nav-link>Pricing</a>
        <a href="#contact" data-lp-nav-link>Contact</a>
        <a asp-page="/Account/Register">Register</a>
        <a asp-page="/Account/Login">Sign in</a>
        <a class="lp-btn lp-btn--ghost lp-nav__cta" data-lp-nav-cta data-lp-download href="@download">Download the free app</a>
    </nav>
    <a class="lp-nav__menu" href="#lp-drawer" role="button" data-lp-menu aria-expanded="false" aria-controls="lp-drawer" aria-label="Open menu">
        <span></span><span></span><span></span>
    </a>
</header>
<a id="lp-drawer-backdrop" class="lp-drawer-backdrop" href="#" hidden data-lp-close-backdrop aria-label="Close menu" tabindex="-1"></a>
<div id="lp-drawer" class="lp-drawer" hidden aria-label="Menu">
    <a class="lp-drawer__close" href="#" role="button" data-lp-close aria-label="Close menu">
        <svg class="lp-drawer__close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </a>
    <nav aria-label="Mobile">
        <a href="#problems" data-lp-close data-lp-nav-link>Why NeedleBase</a>
        <a href="#how" data-lp-close data-lp-nav-link>How it works</a>
        <a href="#pricing" data-lp-close data-lp-nav-link>Pricing</a>
        <a href="#contact" data-lp-close data-lp-nav-link>Contact</a>
        <a asp-page="/Account/Register" data-lp-close>Register</a>
        <a asp-page="/Account/Login" data-lp-close>Sign in</a>
        <a class="lp-btn lp-btn--ghost lp-nav__cta" data-lp-nav-cta data-lp-download href="@download" data-lp-close>Download the free app</a>
    </nav>
</div>

<main id="main" data-lp-drawer-outside>
    <section id="top" class="lp-hero" aria-labelledby="hero-title">
        <div class="lp-hero__media lp-hero__media--mobile">
            <picture>
                <source type="image/avif" srcset="@Srcset("contact-kumasi", "avif", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                <source type="image/webp" srcset="@Srcset("contact-kumasi", "webp", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                <img src="/img/landing/contact-kumasi-960.jpg"
                     srcset="@Srcset("contact-kumasi", "jpg", 480, 720, 960, 1280, 1600)"
                     sizes="100vw"
                     width="960" height="1440"
                     alt="A tailor in Kumasi, Ghana, sewing at a machine."
                     fetchpriority="high" decoding="async" />
            </picture>
        </div>
        <div class="lp-hero__media lp-hero__media--desk" data-lp-parallax-y>
            <picture>
                <source type="image/avif" srcset="@Srcset("hero-takoradi", "avif", 640, 960, 1280, 1600, 1920, 2560)" sizes="100vw" />
                <source type="image/webp" srcset="@Srcset("hero-takoradi", "webp", 640, 960, 1280, 1600, 1920, 2560)" sizes="100vw" />
                <img src="/img/landing/hero-takoradi-1280.jpg"
                     srcset="@Srcset("hero-takoradi", "jpg", 640, 960, 1280, 1600, 1920, 2560)"
                     sizes="100vw"
                     width="1280" height="852"
                     alt="A seamstress in Takoradi, Ghana, sewing at a machine in a roadside workshop."
                     loading="lazy" decoding="async" />
            </picture>
        </div>
        <div class="lp-hero__veil" aria-hidden="true"></div>
        <div class="lp-hero__grid">
            <div class="lp-hero__copy">
                <p class="lp-kicker"><span class="lp-kicker__dot" aria-hidden="true"></span>
                    <span class="lp-kicker__full">NeedleBase for tailors and fashion workshops in Ghana</span>
                    <span class="lp-kicker__short">NeedleBase for tailors in Ghana</span>
                </p>
                <div class="lp-hero__mid">
                    <h1 id="hero-title">Every customer's measurements, on your phone. <span class="lp-sr-only">No more flipping through old books.</span> <span class="lp-hero__accent" data-lp-rotate aria-hidden="true"><span class="lp-hero__rotate" data-lp-rotate-viewport><span class="lp-hero__rotate-item is-active">No more flipping through old books.</span><span class="lp-hero__rotate-item">No more lost measurement books.</span><span class="lp-hero__rotate-item">No more chasing collection dates.</span><span class="lp-hero__rotate-item">No more guessing what is left to pay.</span></span></span></h1>
                    <p class="lp-lead">Works even when there's no data.</p>
                </div>
                <div class="lp-hero__actions">
                    <div class="lp-hero__cta">
                        <a class="lp-btn lp-btn--primary lp-btn--xl" data-lp-hero-cta data-lp-download href="@download">
                            Download the free app
                            <span class="lp-btn__arrow" aria-hidden="true">→</span>
                        </a>
                        <a class="lp-hero__secondary" href="@paidWa" rel="noopener" target="_blank">
                            <span class="lp-hero__secondary-desk">Have staff? Get a paid plan on WhatsApp</span>
                            <span class="lp-hero__secondary-mob">Have staff? Paid plans on WhatsApp <span aria-hidden="true">→</span></span>
                        </a>
                    </div>
                    <p class="lp-hero__trust">Android · Made in Ghana · No card needed</p>
                </div>
            </div>
            <div class="lp-hero__device">
                <p class="lp-sr-only">Sample of the NeedleBase phone app.</p>
                <partial name="_AppHomeMockup" model="@(true)" />
            </div>
        </div>
    </section>

    <section class="lp-glance" aria-labelledby="glance-title">
        <div class="lp-glance__inner">
            <h2 id="glance-title">Your workshop at a glance</h2>
            <partial name="_AppHomeMockup" model="@(false)" />
            <p class="lp-glance__caption">Sample of the app's home screen</p>
        </div>
    </section>

    <section class="lp-promises" aria-label="What you can count on">
        <ul class="lp-promises__list">
            <li>
                <p class="lp-promises__title">Works with no data</p>
                <p>Take orders and measurements offline.</p>
            </li>
            <li>
                <p class="lp-promises__title">No hidden fees</p>
                <p>We never take a cut of your payments.</p>
            </li>
            <li>
                <p class="lp-promises__title">Pay your way</p>
                <p>Monthly, every 3 months or yearly.</p>
            </li>
        </ul>
    </section>

    <section id="problems" class="lp-section lp-section--problems lp-mesh lp-mesh--light" aria-labelledby="problems-title">
        <div class="lp-section__inner">
            <div class="lp-section__head" data-lp-reveal>
                <h2 id="problems-title">The headaches of a busy fashion workshop</h2>
                <p class="lp-section__lead">Lost books, slipped dates, unclear balances — these will sound familiar.</p>
            </div>
            <ul class="lp-pain" data-lp-reveal>
                <li>
                    <span class="lp-pain__num" aria-hidden="true">01</span>
                    <h3>Measurement books go missing</h3>
                    <p>A notebook walks off, pages tear, or nobody can read the last fitting — and you measure the customer again.</p>
                </li>
                <li>
                    <span class="lp-pain__num" aria-hidden="true">02</span>
                    <h3>Collection dates slip</h3>
                    <p>Promised Friday, remembered Monday. Customers call, you dig through scraps of paper to find the order.</p>
                </li>
                <li>
                    <span class="lp-pain__num" aria-hidden="true">03</span>
                    <h3>Balances are unclear</h3>
                    <p>Deposit here, part-payment there — you're not sure what is left on a job until the customer is at the counter.</p>
                </li>
                <li>
                    <span class="lp-pain__num" aria-hidden="true">04</span>
                    <h3>Who is sewing what?</h3>
                    <p>Workroom is busy, but you can't see which tailor has which order, or whether cutting is done.</p>
                </li>
            </ul>
            <p class="lp-section__nudge" data-lp-reveal>
                If that sounds like your workshop, <a class="lp-text-link" href="@download">download the free app</a> and start on your phone.
            </p>
        </div>
    </section>

    <section id="benefits" class="lp-deck" data-lp-deck aria-labelledby="benefits-title">
        <div class="lp-deck__sticky">
            <div class="lp-deck__head">
                <h2 id="benefits-title">One place for the work that fills your day</h2>
                <p class="lp-section__lead">Tools that match how a tailor or fashion workshop actually runs.</p>
                <p class="lp-sr-only">Four feature cards follow. Scroll to deal the next card, or use the previous and next buttons.</p>
            </div>
            <div class="lp-deck__stage-wrap">
            <p class="lp-deck__swipe-hint" data-lp-deck-hint aria-hidden="true"><span>Scroll</span></p>
            <div class="lp-deck__stage" data-lp-deck-stage>
                <div class="lp-deck__card" data-lp-deck-card>
                    <div class="lp-deck__media">
                        <picture>
                            <source type="image/avif" srcset="@Srcset("split-workshop", "avif", 640, 960, 1280)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <source type="image/webp" srcset="@Srcset("split-workshop", "webp", 640, 960, 1280)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <img src="/img/landing/split-workshop-960.jpg"
                                 srcset="@Srcset("split-workshop", "jpg", 640, 960, 1280)"
                                 sizes="(min-width: 860px) 50vw, 100vw"
                                 width="1280" height="720"
                                 alt="Generated photograph of a Ghanaian fashion workshop, with seamstresses sewing and cutting colourful wax-print fabric."
                                 loading="lazy" decoding="async" />
                        </picture>
                    </div>
                    <div class="lp-deck__copy">
                        <span class="lp-deck__idx">01 / 04</span>
                        <h3>Know every order's stage</h3>
                        <p>Follow a job from new → cutting → sewing → finishing → ready → collected. See what's late and who it's assigned to.</p>
                        <div class="lp-deck__mini" aria-hidden="true">
                            <div class="lp-deck__mini-bar">
                                <span>NeedleBase</span>
                                <span class="lp-ui__pill">Sample</span>
                            </div>
                            <p class="lp-mini__job">Kaba &amp; slit</p>
                            <ol class="lp-deck__stages">
                                <li class="is-done">New</li>
                                <li class="is-done">Cutting</li>
                                <li class="is-now">Sewing</li>
                                <li>Finishing</li>
                                <li>Ready</li>
                                <li>Collected</li>
                            </ol>
                            <p class="lp-mini__meta">Due Friday · Sample</p>
                        </div>
                    </div>
                </div>

                <div class="lp-deck__card" data-lp-deck-card>
                    <div class="lp-deck__media">
                        <picture>
                            <source type="image/avif" srcset="@Srcset("split-measure", "avif", 640, 960, 1152)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <source type="image/webp" srcset="@Srcset("split-measure", "webp", 640, 960, 1152)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <img src="/img/landing/split-measure-960.jpg"
                                 srcset="@Srcset("split-measure", "jpg", 640, 960, 1152)"
                                 sizes="(min-width: 860px) 50vw, 100vw"
                                 width="1152" height="864"
                                 alt="Generated photograph of a Ghanaian seamstress measuring a client in a workshop."
                                 loading="lazy" decoding="async" />
                        </picture>
                    </div>
                    <div class="lp-deck__copy">
                        <span class="lp-deck__idx">02 / 04</span>
                        <h3>Measurements stay with the customer</h3>
                        <p>Open their card next time they walk in — phone number and sizes ready on the phone or computer.</p>
                        <div class="lp-deck__mini" aria-hidden="true">
                            <div class="lp-deck__mini-bar">
                                <span>Customer card</span>
                                <span class="lp-ui__pill">Sample</span>
                            </div>
                            <dl class="lp-deck__measures">
                                <div><dt>Chest</dt><dd>38</dd></div>
                                <div><dt>Waist</dt><dd>30</dd></div>
                                <div><dt>Hip</dt><dd>42</dd></div>
                                <div><dt>Length</dt><dd>54</dd></div>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="lp-deck__card" data-lp-deck-card>
                    <div class="lp-deck__media">
                        <picture>
                            <source type="image/avif" srcset="@Srcset("split-fabric", "avif", 640, 960, 1280)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <source type="image/webp" srcset="@Srcset("split-fabric", "webp", 640, 960, 1280)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <img src="/img/landing/split-fabric-960.jpg"
                                 srcset="@Srcset("split-fabric", "jpg", 640, 960, 1280)"
                                 sizes="(min-width: 860px) 50vw, 100vw"
                                 width="1280" height="720"
                                 alt="Generated photograph of ankara and kente fabric, a measuring tape, shears and a phone on a workshop table."
                                 loading="lazy" decoding="async" />
                        </picture>
                    </div>
                    <div class="lp-deck__copy">
                        <span class="lp-deck__idx">03 / 04</span>
                        <h3>Clear money on each job</h3>
                        <p>Record deposits and balances against the order. Owners and managers see payments; tailors stay in the workroom.</p>
                        <div class="lp-deck__mini" aria-hidden="true">
                            <div class="lp-deck__mini-bar">
                                <span>Kaba &amp; slit</span>
                                <span class="lp-ui__pill">Sample</span>
                            </div>
                            <ul class="lp-deck__pay">
                                <li>Deposit <b>GH₵200</b></li>
                                <li class="is-due">Balance <b>GH₵80 left</b></li>
                                <li>Suit <b>Paid</b></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="lp-deck__card" data-lp-deck-card>
                    <div class="lp-deck__media">
                        <picture>
                            <source type="image/avif" srcset="@Srcset("split-owner", "avif", 640, 960, 1152)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <source type="image/webp" srcset="@Srcset("split-owner", "webp", 640, 960, 1152)" sizes="(min-width: 860px) 50vw, 100vw" />
                            <img src="/img/landing/split-owner-960.jpg"
                                 srcset="@Srcset("split-owner", "jpg", 640, 960, 1152)"
                                 sizes="(min-width: 860px) 50vw, 100vw"
                                 width="1152" height="864"
                                 alt="Generated photograph of a Ghanaian workshop owner checking a phone beside a laptop and rolls of fabric."
                                 loading="lazy" decoding="async" />
                        </picture>
                    </div>
                    <div class="lp-deck__copy">
                        <span class="lp-deck__idx">04 / 04</span>
                        <h3>Phone works when data drops</h3>
                        <p>Keep taking orders and measurements offline. When you're back online, the phone updates the shop so nothing is left behind.</p>
                        <div class="lp-deck__mini" aria-hidden="true">
                            <div class="lp-deck__mini-bar">
                                <span>On this phone</span>
                                <span class="lp-ui__pill">Sample</span>
                            </div>
                            <p class="lp-deck__sync"><span class="lp-deck__dot"></span> Saved on this phone — no internet just now</p>
                            <p class="lp-mini__meta">Updates when you're back online · Sample</p>
                        </div>
                    </div>
                </div>
            </div>
            </div>
            <div class="lp-deck__hud">
                <button type="button" class="lp-deck__arrow" data-lp-deck-prev aria-label="Previous card">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                </button>
                <div class="lp-deck__dots" data-lp-deck-dots>
                    <button type="button" data-lp-deck-dot="1" aria-label="Card 1 of 4" aria-current="true"></button>
                    <button type="button" data-lp-deck-dot="2" aria-label="Card 2 of 4"></button>
                    <button type="button" data-lp-deck-dot="3" aria-label="Card 3 of 4"></button>
                    <button type="button" data-lp-deck-dot="4" aria-label="Card 4 of 4"></button>
                </div>
                <p>Card <span data-lp-deck-pos>1</span> of 4</p>
                <button type="button" class="lp-deck__arrow" data-lp-deck-next aria-label="Next card">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
                </button>
            </div>
            <p class="lp-deck__nudge">
                Ready to try it? <a class="lp-text-link" href="@download">Download the free app</a>
            </p>
        </div>
    </section>

    <section id="demo" class="lp-section lp-section--demo" aria-labelledby="demo-title">
        <div class="lp-section__inner">
            <div class="lp-section__head" data-lp-reveal>
                <h2 id="demo-title">See an order</h2>
                <p class="lp-section__lead">A walkthrough of a sample order, from first cut through to collection.</p>
            </div>
            <article class="lp-order" data-lp-reveal aria-label="Sample order">
                <p class="lp-order__sample">Sample order</p>
                <header class="lp-order__top">
                    <div>
                        <h3>Kaba &amp; slit</h3>
                        <p>For Ama · due Friday</p>
                    </div>
                    <p class="lp-order__now">Sewing</p>
                </header>
                <ol class="lp-order__stages">
                    <li class="is-done">New</li>
                    <li class="is-done">Cutting</li>
                    <li class="is-now">Sewing</li>
                    <li>Finishing</li>
                    <li>Ready</li>
                    <li>Collected</li>
                </ol>
                <dl class="lp-order__facts">
                    <div><dt>Assigned to</dt><dd>Kofi, tailor</dd></div>
                    <div><dt>Total</dt><dd>GH₵250</dd></div>
                    <div><dt>Deposit</dt><dd>GH₵150</dd></div>
                    <div><dt>Balance</dt><dd>GH₵100</dd></div>
                </dl>
                <p class="lp-order__note">On a paid plan, every phone and computer updates when you're back online.</p>
            </article>
        </div>
    </section>

    <section id="how" class="lp-section lp-section--how" aria-labelledby="how-title">
        <div class="lp-hand__row">
            <div>
                <div class="lp-hand__head lp-section__head lp-section__head--left" data-lp-reveal>
                    <h2 id="how-title">How to get started</h2>
                    <p class="lp-section__lead">Start on your phone today. Add staff later, when you need them.</p>
                </div>
                <ol class="lp-hand">
                    <li data-lp-reveal>
                        <span class="lp-hand__num" aria-hidden="true">01</span>
                        <h3>Download the free app</h3>
                        <p>Use it on your phone straight away. No form and no key. <a class="lp-text-link" href="@download">Download the free app</a>.</p>
                    </li>
                    <li data-lp-reveal>
                        <span class="lp-hand__num" aria-hidden="true">02</span>
                        <h3>Add your customers and orders</h3>
                        <p>Up to 10 customers and 20 orders on Free.</p>
                    </li>
                    <li data-lp-reveal>
                        <span class="lp-hand__num" aria-hidden="true">03</span>
                        <h3>Ready for staff or a computer?</h3>
                        <p><a class="lp-text-link" href="@paidWa" rel="noopener" target="_blank">Message us on WhatsApp</a>, pick a plan, and we email your key. Your records come with you.</p>
                    </li>
                </ol>
            </div>
            <div class="lp-hand__device" data-lp-reveal>
                <div class="lp-device lp-device--laptop" data-lp-tilt aria-hidden="true">
                    <div class="lp-device__lid">
                        <div class="lp-device__camera"></div>
                        <div class="lp-ui lp-ui--desk">
                            <div class="lp-ui__bar">
                                <span class="lp-ui__brand">NeedleBase</span>
                                <span class="lp-ui__pill">Sample</span>
                            </div>
                            <p class="lp-ui__k">Orders on the computer</p>
                            <table class="lp-ui__table">
                                <thead><tr><th>Job</th><th>Stage</th><th>Balance</th></tr></thead>
                                <tbody>
                                    <tr><td>Kaba &amp; slit</td><td>Cutting</td><td>GH₵80</td></tr>
                                    <tr><td>Suit</td><td>Sewing</td><td>Paid</td></tr>
                                    <tr><td>Dress</td><td>Ready</td><td>GH₵40</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="lp-device__base"><span></span></div>
                </div>
                <p class="lp-device__cap lp-device__cap--light">Sample computer screen</p>
            </div>
        </div>
    </section>

    <section class="lp-kente-wrap" aria-labelledby="about-title">
        <div class="lp-kente">
            <div class="lp-kente__media">
                <picture>
                    <source type="image/avif" srcset="@Srcset("band-kente", "avif", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                    <source type="image/webp" srcset="@Srcset("band-kente", "webp", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                    <img src="/img/landing/band-kente-960.jpg"
                         srcset="@Srcset("band-kente", "jpg", 480, 720, 960, 1280, 1600)"
                         sizes="100vw"
                         width="960" height="1440"
                         alt="A craftsman weaving kente cloth on a traditional loom in Accra, Ghana."
                         loading="lazy" decoding="async" />
                </picture>
            </div>
            <div class="lp-kente__veil" aria-hidden="true"></div>
            <div class="lp-kente__copy" data-lp-reveal>
                <h2 id="about-title" class="lp-kente__line">Made in Ghana by HelmutCode Solutions.</h2>
                <p>We built NeedleBase for tailors, seamstresses and dressmakers who want their records safe and simple.</p>
            </div>
        </div>
    </section>

    <section id="pricing" class="lp-section lp-section--pricing" aria-labelledby="pricing-title">
        <div class="lp-section__inner">
            <div class="lp-section__head lp-section__head--left" data-lp-reveal>
                <p class="lp-eyebrow">Pricing</p>
                <h2 id="pricing-title">Simple plans in Ghana cedis</h2>
                <p class="lp-section__lead">A year costs the same as 10 months. Prices exclude VAT.</p>
            </div>
            <div class="lp-pricing-wrap" data-lp-reveal>
                <div class="lp-bill" role="radiogroup" aria-label="Billing period">
                    <input type="radio" name="lp-bill" id="lp-bill-month" checked />
                    <label class="lp-bill__opt" for="lp-bill-month">Monthly</label>
                    <input type="radio" name="lp-bill" id="lp-bill-quarter" />
                    <label class="lp-bill__opt" for="lp-bill-quarter">Every 3 months</label>
                    <input type="radio" name="lp-bill" id="lp-bill-year" />
                    <label class="lp-bill__opt lp-bill__opt--year" for="lp-bill-year">
                        <span class="lp-bill__year">Yearly</span>
                        <span class="lp-bill__save lp-bill__save--full">Save two months</span>
                        <span class="lp-bill__save lp-bill__save--short">−2 months</span>
                    </label>
                </div>
                <div class="lp-pricing">
                    @foreach (var plan in Model.Plans)
                    {
                        var planWa = LandingSalesInfo.WhatsAppUrlForPlan(plan.Name);
                        <article class="lp-plan@(plan.Featured ? " lp-plan--featured" : "")@(plan.IsFree ? " lp-plan--free" : "")">
                            <h3>@plan.Name</h3>
                            <p class="lp-plan__tag">@plan.Tagline</p>
                            <p class="lp-plan__price lp-plan__price--month">
                                <span class="lp-plan__amount">GH₵@plan.MonthlyGhs.ToString("N0")</span>
                                <span class="lp-plan__per">/ month</span>
                            </p>
                            <p class="lp-plan__price lp-plan__price--quarter">
                                <span class="lp-plan__amount">GH₵@plan.QuarterlyGhs.ToString("N0")</span>
                                <span class="lp-plan__per">/ 3 months</span>
                            </p>
                            <p class="lp-plan__price lp-plan__price--year">
                                <span class="lp-plan__amount">GH₵@plan.YearlyGhs.ToString("N0")</span>
                                <span class="lp-plan__per">/ year</span>
                            </p>
                            @if (!plan.IsFree)
                            {
                                <p class="lp-plan__yearly lp-plan__alt--month">@plan.MonthlyAlt</p>
                                <p class="lp-plan__yearly lp-plan__alt--quarter">@plan.QuarterlyAlt</p>
                                <p class="lp-plan__yearly lp-plan__alt--year">@plan.YearlyAlt</p>
                            }
                            <ul class="lp-plan__list">
                                @foreach (var h in plan.Highlights)
                                {
                                    <li>@h.Text</li>
                                }
                            </ul>
                            @if (!string.IsNullOrEmpty(plan.ComingSoonNote))
                            {
                                <p class="lp-plan__soon">@plan.ComingSoonNote</p>
                            }
                            @if (plan.LimitationItems.Count > 0)
                            {
                                <p class="lp-plan__limits-label">Not included</p>
                                <ul class="lp-plan__list lp-plan__list--limits">
                                    @foreach (var limit in plan.LimitationItems)
                                    {
                                        <li>@limit</li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrEmpty(plan.Footnote))
                            {
                                <p class="lp-plan__footnote">@plan.Footnote</p>
                            }
                            @if (plan.IsFree)
                            {
                                <a class="lp-btn lp-btn--ghost lp-btn--lg"
                                   data-lp-download
                                   href="@download"
                                   title="Download the free NeedleBase Android app">
                                    Download the free app
                                </a>
                            }
                            else
                            {
                                <a class="lp-btn @(plan.Featured ? "lp-btn--primary" : "lp-btn--ghost") lp-btn--lg"
                                   href="@planWa" rel="noopener" target="_blank"
                                   title="Opens WhatsApp so we can set you up with the @plan.Name plan"
                                   aria-label="Choose @plan.Name — opens WhatsApp so we can send a licence key">
                                    Choose @plan.Name
                                </a>
                            }
                        </article>
                    }
                </div>
            </div>
            <p class="lp-pricing__note" data-lp-reveal>
                Prices exclude VAT. To start a paid plan, message us on WhatsApp or email and we will send a licence key. The Free plan runs on your phone — download the free app to get started.
            </p>
        </div>
    </section>

    <section id="faq" class="lp-section lp-section--faq" aria-labelledby="faq-title">
        <div class="lp-section__inner lp-faq-layout">
            <div class="lp-faq__intro" data-lp-reveal>
                <p class="lp-eyebrow">Questions</p>
                <h2 id="faq-title">Before you get started</h2>
                <p class="lp-section__lead">A few things people usually ask. If you need something else, message us and we'll answer.</p>
                <p class="lp-faq__cta"><a class="lp-btn lp-btn--primary lp-btn--lg" href="@wa" rel="noopener" target="_blank">Message us on WhatsApp</a></p>
            </div>
            <div class="lp-faq">
                <details>
                    <summary>Who is NeedleBase for?</summary>
                    <div class="lp-faq__body"><p>Tailors, seamstresses, dressmakers and fashion workshop owners — especially in Ghana and West Africa — who want one place for customers, measurements, orders and payments. You can start free on one phone, or use a paid plan if you have staff or more than one device.</p></div>
                </details>
                <details>
                    <summary>How do I get started?</summary>
                    <div class="lp-faq__body"><p>Download the free app and use it on your phone straight away. No form and no key. Add your customers and orders — up to 10 customers and 20 orders on Free. When you need staff or a computer, message us on WhatsApp, pick a plan, and we email your key. Your records come with you.</p></div>
                </details>
                <details>
                    <summary>How much does NeedleBase cost?</summary>
                    <div class="lp-faq__body"><p>Free is GH₵0. Starter is GH₵50 a month, Workshop GH₵150, and Production GH₵300. You can also pay every 3 months or by the year (a year costs the same as 10 months). Prices exclude VAT. Download the free app to use Free on your phone, or message us for a paid-plan licence key.</p></div>
                </details>
                <details>
                    <summary>What can't I do on Free?</summary>
                    <div class="lp-faq__body"><p>Free works on one phone only, and staff can't join. You can't use it on a computer or the website. It stops at 10 customers and 20 orders, and deleting one doesn't give the space back. Your records are only on that phone — NeedleBase doesn't keep a copy — so if the phone is lost or the app is removed, the records are gone unless you saved a copy. There are no summary emails. If you move to a paid plan, your records come with you.</p></div>
                </details>
                <details>
                    <summary>Does the phone need internet all day?</summary>
                    <div class="lp-faq__body"><p>No. You can save customers, measurements and orders on the phone with no internet. On a paid plan, when you're back online the phone updates the rest of the shop. The Free plan stays on that one phone.</p></div>
                </details>
                <details>
                    <summary>Do my staff need a licence key?</summary>
                    <div class="lp-faq__body"><p>Staff can only join on a paid plan. Only the shop owner registers with the licence key. Managers and tailors then join with an invite you send. On Free, staff can't join.</p></div>
                </details>
                <details>
                    <summary>How do I get a licence key?</summary>
                    <div class="lp-faq__body"><p>You don't need one for Free. For a paid plan, message us on WhatsApp or email. After you agree on a plan, we send your licence key by email. Use that same email when you register the shop.</p></div>
                </details>
                <details>
                    <summary>How do I contact you?</summary>
                    <div class="lp-faq__body"><p>WhatsApp <a class="lp-text-link" href="@wa" rel="noopener" target="_blank">@Model.WhatsAppDisplay</a> or email <a class="lp-text-link" href="@mail">@Model.Email</a>.</p></div>
                </details>
            </div>
        </div>
    </section>

    <section id="contact" class="lp-cta-wrap" aria-labelledby="cta-title">
        <div class="lp-cta">
            <div class="lp-cta__media lp-cta__media--mobile">
                <picture>
                    <source type="image/avif" srcset="@Srcset("band-kente", "avif", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                    <source type="image/webp" srcset="@Srcset("band-kente", "webp", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                    <img src="/img/landing/band-kente-960.jpg"
                         srcset="@Srcset("band-kente", "jpg", 480, 720, 960, 1280, 1600)"
                         sizes="100vw"
                         width="960" height="1440"
                         alt="Traditional kente weaving in Accra, Ghana."
                         loading="lazy" decoding="async" />
                </picture>
            </div>
            <div class="lp-cta__media lp-cta__media--desk">
                <picture>
                    <source type="image/avif" srcset="@Srcset("contact-kumasi", "avif", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                    <source type="image/webp" srcset="@Srcset("contact-kumasi", "webp", 480, 720, 960, 1280, 1600)" sizes="100vw" />
                    <img src="/img/landing/contact-kumasi-960.jpg"
                         srcset="@Srcset("contact-kumasi", "jpg", 480, 720, 960, 1280, 1600)"
                         sizes="100vw"
                         width="960" height="1440"
                         alt="A tailor in Kumasi, Ghana, sewing on a machine with ankara fabric at hand."
                         loading="lazy" decoding="async" />
                </picture>
            </div>
            <div class="lp-cta__veil" aria-hidden="true"></div>
            <div class="lp-cta__inner" data-lp-reveal>
                <h2 id="cta-title">Ready to put your next order in one place?</h2>
                <p>Start on your phone today. When you need staff, chat with us and we'll help you pick a plan.</p>
                <div class="lp-hero__cta">
                    <a class="lp-btn lp-btn--primary lp-btn--lg" data-lp-download href="@download">Download the free app</a>
                    <a class="lp-btn lp-btn--ghost lp-btn--lg" href="@paidWa" rel="noopener" target="_blank">or chat with us on WhatsApp</a>
                </div>
                <p class="lp-fine">
                    WhatsApp <a class="lp-text-link" href="@wa" rel="noopener" target="_blank">@Model.WhatsAppDisplay</a>
                    · <a class="lp-text-link" href="@mail">@Model.Email</a>
                </p>
            </div>
        </div>
    </section>
    <p class="lp-illustrate">Photos and sample orders are for illustration.</p>
</main>

<footer class="lp-footer" data-lp-drawer-outside>
    <div class="lp-footer__grid">
        <div class="lp-footer__brand">
            <p class="lp-footer__brand-text">NeedleBase by HelmutCode Solutions</p>
            <p>Tailoring shop software for Ghana and West Africa · Measure · Cut · Sew · Deliver</p>
        </div>
        <nav class="lp-footer__col" aria-label="Product">
            <h2 class="lp-footer__heading">Product</h2>
            <a class="lp-footer__link" href="#how">How it works</a>
            <a class="lp-footer__link" href="#pricing">Pricing</a>
            <a class="lp-footer__link" href="#faq">Questions</a>
            <a class="lp-footer__link" data-lp-download href="@download">Download the free app</a>
        </nav>
        <nav class="lp-footer__col" aria-label="Account">
            <h2 class="lp-footer__heading">Account</h2>
            <a class="lp-footer__link" asp-page="/Account/Register">Register</a>
            <a class="lp-footer__link" asp-page="/Account/Login">Sign in</a>
            <a class="lp-footer__link" href="/account/delete">Delete account</a>
            <a class="lp-footer__link" asp-page="/Terms">Terms</a>
            <a class="lp-footer__link" asp-page="/Privacy">Privacy</a>
        </nav>
        <nav class="lp-footer__col" aria-label="Contact">
            <h2 class="lp-footer__heading">Contact</h2>
            <a class="lp-footer__link" href="#contact">Contact</a>
            <a class="lp-footer__link" href="@wa" rel="noopener" target="_blank">WhatsApp</a>
            <a class="lp-footer__link" href="@mail">Email</a>
            <a class="lp-footer__link" href="@helpWa" rel="noopener" target="_blank">Help</a>
            <a class="lp-footer__link" href="@feedbackWa" rel="noopener" target="_blank">Send us feedback</a>
        </nav>
    </div>
    <p class="lp-footer__legal">© 2026 NeedleBase</p>
</footer>

<aside class="lp-sticky-download" data-lp-sticky-download aria-hidden="true" inert>
    <a class="lp-btn lp-btn--primary" href="@download">Download the free app</a>
</aside>


