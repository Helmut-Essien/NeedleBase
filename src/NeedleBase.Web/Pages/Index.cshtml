@page
@model IndexModel
@using NeedleBase.Web.Services
@{
    ViewData["Title"] = "Dashboard";
}
<h1 class="nb-page-title">Dashboard</h1>
<p class="nb-meta">@User.BusinessName()@(Model.Summary is null ? "" : " · " + Model.Summary.Today.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-GH")))</p>
<partial name="_PageState" model="Model" />

@if (Model.Summary is { } s)
{
    var statusTotal = s.ByStatus.Sum(c => c.Count);
    <section aria-labelledby="work-heading" class="nb-section">
        <h2 id="work-heading" class="visually-hidden">Workload</h2>
        <div class="nb-stats">
            <a class="nb-stat" asp-page="/Orders/Index" asp-route-status="open">
                <span class="nb-stat__icon" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><path d="M7 3h10l2 3v15H5V6z"/><path d="M9 10h6M9 14h6"/></svg></span><span><span class="nb-stat__value">@s.ActiveOrders</span><span class="nb-stat__label">Active orders</span></span>
            </a>
            <a class="nb-stat @(s.Overdue > 0 ? "nb-stat--warn" : "")" asp-page="/Production/Index">
                <span class="nb-stat__icon" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><span class="nb-stat__value">@s.Overdue</span><span class="nb-stat__label">Overdue</span></span>
            </a>
            <div class="nb-stat"><span class="nb-stat__icon" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span><span><span class="nb-stat__value">@s.DueNext7Days</span><span class="nb-stat__label">Due in 7 days</span></span></div>
            <div class="nb-stat"><span class="nb-stat__icon" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><path d="M12 3a2 2 0 0 0-2 2c0 1 1 1.5 2 2v1L3 15h18l-9-7"/></svg></span><span><span class="nb-stat__value">@s.FittingsNext7Days</span><span class="nb-stat__label">Fittings in 7 days</span></span></div>
        </div>
    </section>

    @if (Model.ShowMoney && s.Money is { } m)
    {
        <section aria-labelledby="money-heading" class="nb-section">
            <h2 id="money-heading" class="nb-section-title">Money</h2>
            <div class="nb-money-grid">
                <a class="nb-hero" asp-page="/Payments/Index">
                    <span class="nb-hero__label">Left to collect</span>
                    <span class="nb-hero__value nb-money">@m.OutstandingDisplay</span>
                    <span class="nb-hero__foot"><span>@m.OrdersWithBalance @(m.OrdersWithBalance == 1 ? "order" : "orders") with a balance</span><span>View payments <span aria-hidden="true">→</span></span></span>
                </a>
                <div class="nb-stat nb-money-card"><span class="nb-stat__label">Recorded today</span><span class="nb-stat__value nb-money">@m.ReceivedTodayDisplay</span></div>
                <div class="nb-stat nb-money-card"><span class="nb-stat__label">Last 7 days</span><span class="nb-stat__value nb-money">@m.ReceivedLast7DaysDisplay</span></div>
            </div>
        </section>
    }

    <div class="nb-dash-cols">
        <section aria-labelledby="due-heading">
            <h2 id="due-heading" class="nb-section-title">Due next</h2>
            @if (Model.DueNext.Count == 0)
            {
                <div class="nb-empty"><span class="nb-empty__icon" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><path d="M7 3h10l2 3v15H5V6z"/><path d="M9 12l2 2 4-4"/></svg></span><strong>No open orders</strong>New orders from the app show here.</div>
            }
            else
            {
                <ul class="nb-list">
                    @foreach (var o in Model.DueNext)
                    {
                        <li>
                            <a class="nb-list__row" asp-page="/Orders/Details" asp-route-id="@o.Id">
                                <span class="nb-list__body"><strong>#@o.DisplayRef</strong> · @o.CustomerName<br /><span class="nb-meta">@o.DueDateDisplay</span></span>
                                <span class="text-end"><partial name="_StatusChip" model="(o.Status, o.IsOverdue)" /></span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
        <div>
            <section class="nb-card" aria-labelledby="status-heading">
                <h2 id="status-heading" class="nb-section-title">By status</h2>
                @if (statusTotal > 0)
                {
                    @* Segment widths as SVG geometry (attributes, not inline styles) so the strict CSP holds. *@
                    var x = 0;
                    <div class="nb-statusbar" aria-hidden="true">
                        <svg viewBox="0 0 @statusTotal 1" preserveAspectRatio="none" focusable="false">
                            @foreach (var c in s.ByStatus.Where(c => c.Count > 0))
                            {
                                <rect class="nb-seg--@c.Status.ToLowerInvariant()" x="@x" y="0" width="@c.Count" height="1" />
                                x += c.Count;
                            }
                        </svg>
                    </div>
                }
                <ul class="nb-status-list">
                    @foreach (var c in s.ByStatus)
                    {
                        <li class="@(c.Count > 0 ? "is-nonzero" : "")"><a asp-page="/Orders/Index" asp-route-status="@c.Status"><span class="nb-dot nb-dot--@c.Status.ToLowerInvariant()" aria-hidden="true"></span>@c.StatusDisplay<span class="nb-num">@c.Count</span></a></li>
                    }
                </ul>
            </section>
            @if (Model.ShowMoney)
            {
                <section class="nb-card mt-4" aria-labelledby="recent-heading">
                    <h2 id="recent-heading" class="nb-section-title">Recent payments</h2>
                    @if (Model.RecentPayments.Count == 0)
                    {
                        <p class="nb-empty">No payments recorded yet.</p>
                    }
                    else
                    {
                        <ul class="nb-list">
                            @foreach (var p in Model.RecentPayments)
                            {
                                <li>
                                    <a class="nb-list__row" asp-page="/Orders/Details" asp-route-id="@p.OrderId">
                                        <span class="nb-list__lead" aria-hidden="true"><svg class="nb-icon" viewBox="0 0 24 24" focusable="false"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg></span>
                                        <span class="nb-list__body">@p.CustomerName · #@p.OrderDisplayRef<br /><span class="nb-meta">@p.Method · @p.RecordedDisplay</span></span>
                                        <span class="nb-money @(p.IsVoided ? "nb-voided" : "")">@p.AmountDisplay@(p.IsVoided ? " (voided)" : "")</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        </div>
    </div>
}
