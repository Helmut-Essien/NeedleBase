@page
@model NeedleBase.Web.Pages.Profile.PasswordModel
@using NeedleBase.Web.Pages.Shared
@{
    ViewData["Title"] = "Change password";
}
<h1 class="nb-page-title">Change password</h1>
<p class="nb-meta">After the change, other phones and browsers signed in to your account are signed out.</p>
<partial name="_PageState" model="Model" />
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
<section class="nb-card nb-narrow">
    <form method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Input.CurrentPassword" class="form-label">Current password</label>
            <div class="nb-password-field">
                <input asp-for="Input.CurrentPassword" id="Input_CurrentPassword" class="form-control nb-password-input" autocomplete="current-password" />
                <partial name="_PasswordToggleButton" model="@(new PasswordToggleModel { InputId = "Input_CurrentPassword" })" />
            </div>
            <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">New password</label>
            <div class="nb-password-field">
                <input asp-for="Input.NewPassword" id="Input_NewPassword" aria-describedby="password-hint" class="form-control nb-password-input" autocomplete="new-password" />
                <partial name="_PasswordToggleButton" model="@(new PasswordToggleModel { InputId = "Input_NewPassword" })" />
            </div>
            <span id="password-hint" class="nb-meta">@NeedleBase.Application.Common.PasswordPolicy.Hint</span>
            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">New password again</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn nb-btn-primary">Change password</button>
    </form>
</section>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true" defer></script>
    <partial name="_ValidationScriptsPartial" />
}
