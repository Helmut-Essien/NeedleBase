@page
@model NeedleBase.Web.Pages.Account.LoginModel
@using NeedleBase.Web.Pages.Shared
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<h1 class="nb-auth-title">Sign in to your business</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger nb-auth-alert" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
}

<form method="post" novalidate class="nb-auth-form">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <div class="nb-auth-field text-start">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control nb-auth-input" autocomplete="username" placeholder="you@business.com" />
        <span asp-validation-for="Input.Email" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.Password" class="form-label">Password</label>
        <div class="nb-password-field">
            <input asp-for="Input.Password"
                   id="Input_Password"
                   class="form-control nb-auth-input nb-password-input"
                   autocomplete="current-password"
                   placeholder="Enter your password" />
            <partial name="_PasswordToggleButton" model="@(new PasswordToggleModel { InputId = "Input_Password" })" />
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="form-check nb-auth-remember text-start">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
    </div>
    <div class="d-grid">
        <button type="submit" class="btn nb-btn-primary nb-auth-submit">Sign in</button>
    </div>
</form>

<p class="nb-auth-footer">
    New business?
    <a asp-page="/Account/Register">Register your business</a>
</p>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
