@page
@model NeedleBase.Web.Pages.Account.ResetPasswordModel
@using NeedleBase.Web.Pages.Shared
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set a new password";
}

<h1 class="nb-auth-title">Set a new password</h1>

@if (Model.Sent)
{
    <div class="alert alert-success nb-auth-alert" role="status">If that email has a NeedleBase account, a code is on its way. It can take a few minutes; check spam too. The code expires in 30 minutes.</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger nb-auth-alert" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
}

<form method="post" novalidate class="nb-auth-form">
    <div class="nb-auth-field text-start">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control nb-auth-input" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.Code" class="form-label">Code from the email</label>
        <input asp-for="Input.Code" class="form-control nb-auth-input" autocomplete="one-time-code" inputmode="numeric" spellcheck="false" placeholder="1234 5678" />
        <span asp-validation-for="Input.Code" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.NewPassword" class="form-label">New password</label>
        <div class="nb-password-field">
            <input asp-for="Input.NewPassword" id="Input_NewPassword" aria-describedby="password-hint" class="form-control nb-auth-input nb-password-input" autocomplete="new-password" />
            <partial name="_PasswordToggleButton" model="@(new PasswordToggleModel { InputId = "Input_NewPassword" })" />
        </div>
        <span id="password-hint" class="nb-auth-helper">@NeedleBase.Application.Common.PasswordPolicy.Hint</span>
        <span asp-validation-for="Input.NewPassword" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.ConfirmPassword" class="form-label">New password again</label>
        <input asp-for="Input.ConfirmPassword" class="form-control nb-auth-input" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="d-grid">
        <button type="submit" class="btn nb-btn-primary nb-auth-submit" data-pending-text="Saving…">Set new password</button>
    </div>
</form>

<p class="nb-auth-footer">
    No code?
    <a asp-page="/Account/ForgotPassword">Send a new one</a>
</p>
<p class="nb-auth-footer">
    <a asp-page="/Account/Login">Back to sign in</a>
</p>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true" defer></script>
    <partial name="_ValidationScriptsPartial" />
}
