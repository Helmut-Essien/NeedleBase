@page
@model NeedleBase.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<h1 class="nb-auth-title">Forgot password</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger nb-auth-alert" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
}

@if (Model.Unavailable)
{
    <p class="nb-auth-subtitle">Password reset by email isn't set up yet. Ask the shop owner for help.</p>
}
else
{
    <p class="nb-auth-subtitle">Enter the email you sign in with. We'll email you a code to set a new password.</p>
    <form method="post" novalidate class="nb-auth-form">
        <div class="nb-auth-field text-start">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control nb-auth-input" autocomplete="username" placeholder="you@business.com" />
            <span asp-validation-for="Email" class="text-danger small nb-auth-error"></span>
        </div>
        <div class="d-grid">
            <button type="submit" class="btn nb-btn-primary nb-auth-submit" data-pending-text="Sending…">Email me a code</button>
        </div>
    </form>
}

<p class="nb-auth-footer">
    Already have a code?
    <a asp-page="/Account/ResetPassword">Enter it</a>
</p>
<p class="nb-auth-footer">
    Remembered it?
    <a asp-page="/Account/Login">Sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
