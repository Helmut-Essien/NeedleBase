@page
@model NeedleBase.Web.Pages.Account.RegisterModel
@using NeedleBase.Web.Pages.Shared
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register business";
}

<h1 class="nb-auth-title">Register your business</h1>
<p class="nb-auth-subtitle">Create an owner account for NeedleBase</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger nb-auth-alert" role="alert" aria-live="assertive">@Model.ErrorMessage</div>
}

<form method="post" novalidate class="nb-auth-form">
    <div class="row g-3 nb-auth-name-row">
        <div class="col-12 col-sm-6 text-start">
            <label asp-for="Input.FirstName" class="form-label"></label>
            <input asp-for="Input.FirstName" class="form-control nb-auth-input" autocomplete="given-name" placeholder="First name" />
            <span asp-validation-for="Input.FirstName" class="text-danger small nb-auth-error"></span>
        </div>
        <div class="col-12 col-sm-6 text-start">
            <label asp-for="Input.Surname" class="form-label"></label>
            <input asp-for="Input.Surname" class="form-control nb-auth-input" autocomplete="family-name" placeholder="Surname" />
            <span asp-validation-for="Input.Surname" class="text-danger small nb-auth-error"></span>
        </div>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.BusinessName" class="form-label"></label>
        <input asp-for="Input.BusinessName" class="form-control nb-auth-input" autocomplete="organization" placeholder="e.g. Ama Stitches" />
        <span asp-validation-for="Input.BusinessName" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.BusinessPhone" class="form-label"></label>
        <input asp-for="Input.BusinessPhone" class="form-control nb-auth-input" autocomplete="tel" placeholder="+233..." />
        <span asp-validation-for="Input.BusinessPhone" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control nb-auth-input" autocomplete="username" placeholder="you@business.com" />
        <span asp-validation-for="Input.Email" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.Password" class="form-label"></label>
        <div class="nb-password-field">
            <input asp-for="Input.Password"
                   id="Input_Password"
                   class="form-control nb-auth-input nb-password-input"
                   autocomplete="new-password"
                   placeholder="Create a password"
                   aria-describedby="password-hint" />
            <partial name="_PasswordToggleButton" model="@(new PasswordToggleModel { InputId = "Input_Password" })" />
        </div>
        <p id="password-hint" class="nb-auth-helper mb-0">At least 6 characters, including a number</p>
        <span asp-validation-for="Input.Password" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="nb-auth-field text-start">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <div class="nb-password-field">
            <input asp-for="Input.ConfirmPassword"
                   id="Input_ConfirmPassword"
                   class="form-control nb-auth-input nb-password-input"
                   autocomplete="new-password"
                   placeholder="Confirm your password" />
            <partial name="_PasswordToggleButton" model="@(new PasswordToggleModel
                   {
                       InputId = "Input_ConfirmPassword",
                       ShowLabel = "Show confirm password",
                       HideLabel = "Hide confirm password"
                   })" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="form-check nb-auth-terms text-start">
        <input asp-for="Input.AcceptTerms" class="form-check-input" />
        <label asp-for="Input.AcceptTerms" class="form-check-label">
            I agree to the <a asp-page="/Terms" target="_blank" rel="noopener noreferrer">Terms and Conditions</a> and <a asp-page="/Privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>
        </label>
        <span asp-validation-for="Input.AcceptTerms" class="text-danger small nb-auth-error"></span>
    </div>
    <div class="d-grid">
        <button type="submit" class="btn nb-btn-primary nb-auth-submit" data-pending-text="Creating business…">Create business</button>
    </div>
</form>

<p class="nb-auth-footer">
    Already have an account?
    <a asp-page="/Account/Login">Sign in</a>
</p>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true" defer></script>
    <partial name="_ValidationScriptsPartial" />
}
