@page "{id}"
@model NeedleBase.Web.Pages.Orders.DetailsModel
@using NeedleBase.Application.Contracts.Payments
@{
    ViewData["Title"] = Model.Order is null ? "Order" : "Order #" + Model.Order.DisplayRef;
    var gh = System.Globalization.CultureInfo.GetCultureInfo("en-GH");
}
<a class="nb-back" asp-page="/Orders/Index"><span aria-hidden="true">←</span> Orders</a>
<partial name="_PageState" model="Model" />

@if (Model.Order is { } o)
{
    <div class="nb-title-row">
        <h1 class="nb-page-title mb-0">Order #@o.DisplayRef</h1>
        <partial name="_StatusChip" model="(o.Status, o.IsOverdue)" />
    </div>
    <p class="nb-meta">@o.CustomerName · @o.CustomerPhone · <a asp-page="/Customers/Index" asp-route-search="@o.CustomerPhone">View customer</a></p>
    @if (Model.CanEdit)
    {
        <p><a class="btn nb-btn-outline" asp-page="/Orders/Edit" asp-route-id="@o.Id">Edit order</a></p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <div class="nb-detail-grid">
        <div>
            <section class="nb-card" aria-labelledby="details-heading">
                <h2 id="details-heading" class="nb-section-title">Details</h2>
                <dl class="nb-dl">
                    <dt>Due</dt><dd>@(o.DueDate?.ToString("dd MMM yyyy", gh) ?? "No due date")</dd>
                    <dt>Fitting</dt><dd>@(o.FittingDate?.ToString("dd MMM yyyy", gh) ?? "Not set")</dd>
                    <dt>Assigned to</dt><dd>@(Model.AssigneeName ?? "Not assigned")</dd>
                    <dt>Total</dt><dd class="nb-money">@Money.Format(o.TotalAmount)</dd>
                    <dt>Created</dt><dd>@Money.Date(o.CreatedAtUtc)</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(o.Notes))
                {
                    <p class="mb-0"><strong>Notes:</strong> @o.Notes</p>
                }
            </section>

            <section class="nb-card" aria-labelledby="lines-heading">
                <h2 id="lines-heading" class="nb-section-title">Garments</h2>
                <ul class="nb-list">
                    @foreach (var line in o.Lines)
                    {
                        <li class="nb-list__row nb-line">
                            <div class="nb-line__head">
                                <span>@line.Quantity× @line.GarmentDisplay@if (!string.IsNullOrWhiteSpace(line.Notes)) {<br /><span class="nb-meta">@line.Notes</span>}</span>
                                <span class="nb-money">@Money.Format(line.LineTotal)</span>
                            </div>
                            <div class="nb-measure" aria-label="Measurements for @line.GarmentDisplay">
                                <p class="nb-measure__when">@line.MeasurementTakenDisplay</p>
                                @if (line.HasMeasurements)
                                {
                                    <dl class="nb-measure__grid">
                                        @foreach (var v in line.MeasurementValues)
                                        {
                                            <div><dt>@v.Label</dt><dd>@v.Value</dd></div>
                                        }
                                    </dl>
                                }
                                else
                                {
                                    <p class="mb-0"><a asp-page="/Customers/Index" asp-route-search="@o.CustomerPhone">See the customer's current measurements</a></p>
                                }
                            </div>
                        </li>
                    }
                </ul>
                <p class="nb-meta mb-0 mt-2">Measurements are a copy saved when each garment was added, so later changes to the customer's profile don't alter this order.</p>
            </section>
        </div>

        <div>
            <section class="nb-card" aria-labelledby="status-heading">
                <h2 id="status-heading" class="nb-section-title">Status</h2>
                @if (Model.CanChangeStatus)
                {
                    <form method="post" asp-page-handler="Status" asp-route-id="@o.Id" novalidate>
                        <input type="hidden" asp-for="BaseModified" />
                        @if (!string.IsNullOrWhiteSpace(Model.StatusError))
                        {
                            <div class="alert alert-danger" role="alert" id="status-error">@Model.StatusError</div>
                        }
                        <label for="NewStatus" class="form-label">Change status</label>
                        <select id="NewStatus" name="NewStatus" class="form-select mb-3" required aria-describedby="@(string.IsNullOrWhiteSpace(Model.StatusError) ? null : "status-error")">
                            <option value="">Choose…</option>
                            @foreach (var s in Model.StatusChoices)
                            {
                                <option value="@s">@NeedleBase.Domain.Enums.OrderStatus.DisplayName(s)</option>
                            }
                        </select>
                        <button type="submit" class="btn nb-btn-primary w-100" data-pending-text="Saving…">Save status</button>
                    </form>
                }
                else
                {
                    <p class="mb-0">This order is @NeedleBase.Domain.Enums.OrderStatus.DisplayName(o.Status).ToLowerInvariant(), so its status can't change.</p>
                }
            </section>

            <section class="nb-card" aria-labelledby="wa-heading">
                <h2 id="wa-heading" class="nb-section-title">WhatsApp</h2>
                @if (Model.WhatsAppDigits is null)
                {
                    <p class="mb-0">@NeedleBase.Application.WhatsApp.WhatsAppLinks.NoNumberMessage</p>
                }
                else
                {
                    <form method="post" asp-page-handler="WhatsApp" asp-route-id="@o.Id" target="_blank" rel="noopener">
                        <label for="WhatsAppText" class="form-label">Message (you can change it)</label>
                        <textarea id="WhatsAppText" name="WhatsAppText" class="form-control mb-2" rows="4" maxlength="1000">@Model.DefaultWhatsAppText</textarea>
                        <button type="submit" class="btn nb-btn-outline w-100">Open in WhatsApp</button>
                        <p class="nb-meta mt-2 mb-0">WhatsApp opens with this message. Nothing is sent until you press Send there.</p>
                    </form>
                }
                @if (Model.Consent is { } c)
                {
                    <form method="post" asp-page-handler="Consent" asp-route-id="@o.Id" class="mt-3">
                        <input type="hidden" name="OptIn" value="@(c.OptedIn ? "false" : "true")" />
                        <p class="mb-2">Automatic updates: <strong>@(c.OptedIn ? "On" : "Off")</strong>@(c.Source == "reply" && !c.OptedIn ? " (customer replied STOP)" : "")</p>
                        <button type="submit" class="btn nb-btn-outline btn-sm">@(c.OptedIn ? "Stop automatic updates" : "Customer agreed: send automatic updates")</button>
                    </form>
                }
                @if (Model.WhatsAppLog is { Items.Count: > 0 } log)
                {
                    <ul class="nb-list mt-3">
                        @foreach (var msg in log.Items)
                        {
                            <li class="nb-list__row"><span>@NeedleBase.Domain.Enums.OrderStatus.DisplayName(msg.OrderStatus)<br /><span class="nb-meta">@Money.Date(msg.CreatedAtUtc)@(msg.Error is null ? "" : " · " + msg.Error)</span></span><span>@msg.State</span></li>
                        }
                    </ul>
                }
            </section>

            @if (Model.Payments is { } m)
            {
                <section class="nb-card" aria-labelledby="pay-heading">
                    <h2 id="pay-heading" class="nb-section-title">Payments</h2>
                    <p class="mb-1">@m.PaidSummary</p>
                    <p class="nb-balance">@m.BalanceDisplay</p>
                    @if (m.Payments.Count == 0)
                    {
                        <p class="nb-empty mb-0">No payments recorded yet. Record payments in the NeedleBase app.</p>
                    }
                    else
                    {
                        <ul class="nb-list">
                            @foreach (var p in m.Payments)
                            {
                                <li class="nb-list__row">
                                    <span>@p.Method payment recorded<br /><span class="nb-meta">@Money.Date(p.RecordedAtUtc)@(p.IsVoided ? " · Voided" + (string.IsNullOrWhiteSpace(p.VoidReason) ? "" : ": " + p.VoidReason) : "")</span></span>
                                    <span class="nb-money @(p.IsVoided ? "nb-voided" : "")">@p.AmountDisplay</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @if (Model.History is { } h)
            {
                <section class="nb-card" aria-labelledby="history-heading">
                    <h2 id="history-heading" class="nb-section-title">History</h2>
                    @if (h.Data.Count == 0)
                    {
                        <p class="nb-empty mb-0">No changes recorded yet.</p>
                    }
                    else
                    {
                        <ul class="nb-list nb-activity">
                            @foreach (var e in h.Data)
                            {
                                <li><partial name="_ActivityItem" model="e" /></li>
                            }
                        </ul>
                        @if (h.TotalCount > h.Data.Count)
                        {
                            <p class="mt-2 mb-0"><a asp-page="/Activity/Index" asp-route-order="@Model.Order!.Id">See all @h.TotalCount.ToString("N0") entries</a></p>
                        }
                    }
                </section>
            }
        </div>
    </div>
}
