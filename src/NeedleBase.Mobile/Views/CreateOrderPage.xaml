<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             xmlns:meas="clr-namespace:NeedleBase.Application.Contracts.Measurements;assembly=NeedleBase.Application"
             x:Class="NeedleBase.Mobile.Views.CreateOrderPage"
             x:DataType="vm:CreateOrderViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,24" Spacing="12">
            <Button Text="Back"
                    ImageSource="{mi:Material Icon=ArrowBack, IconColor={StaticResource Charcoal}}"
                    Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding CanGoBack}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Charcoal}"
                    HorizontalOptions="Start"
                    HeightRequest="48"
                    Padding="0,0,12,0"
                    SemanticProperties.Description="Go back" />

            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Charcoal}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding StepLabel}"
                   FontSize="14"
                   TextColor="{StaticResource Gray600}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasError}"
                   LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <!-- Step 1: Customer -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStepCustomer}">
                <Label Text="Who is this order for?"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{StaticResource Charcoal}" />
                <!-- Selected customer card (also the pre-filled state from Customer detail) -->
                <Border IsVisible="{Binding HasSelectedCustomer}"
                        BackgroundColor="White"
                        Stroke="{StaticResource Gray300}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                VerticalOptions="Center">
                            <Label Text="{Binding SelectedCustomerInitials}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding SelectedCustomerName}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{StaticResource Charcoal}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SelectedCustomerPhone}"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="Change"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ChangeCustomerCommand}"
                                VerticalOptions="Center"
                                Padding="16,0"
                                AutomationId="ChangeCustomerButton"
                                SemanticProperties.Description="Change customer" />
                    </Grid>
                </Border>

                <!-- Search-as-you-type picker -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowCustomerPicker}">
                    <Border BackgroundColor="White"
                            Stroke="{StaticResource Gray300}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="48"
                            Padding="12,0,4,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image Grid.Column="0"
                                   Source="{mi:Material Icon=Search, IconColor={StaticResource Gray600}}"
                                   WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" />
                            <Entry x:Name="CustomerSearchEntry"
                                   Grid.Column="1"
                                   Text="{Binding CustomerQuery}"
                                   Placeholder="Search name or phone"
                                   TextColor="{StaticResource Charcoal}"
                                   PlaceholderColor="{StaticResource Gray600}"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="Never"
                                   ReturnType="Search"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   VerticalOptions="Center"
                                   AutomationId="CustomerSearchEntry"
                                   SemanticProperties.Description="Search customers by name or phone" />
                            <ImageButton Grid.Column="2"
                                         Source="{mi:Material Icon=Close, IconColor={StaticResource Gray600}}"
                                         Command="{Binding ClearCustomerQueryCommand}"
                                         IsVisible="{Binding HasCustomerQuery}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="44" HeightRequest="44"
                                         Padding="12"
                                         VerticalOptions="Center"
                                         AutomationId="ClearCustomerSearchButton"
                                         SemanticProperties.Description="Clear search" />
                        </Grid>
                    </Border>

                    <Label Text="{Binding CustomerResultsHeader}"
                           IsVisible="{Binding ShowResults}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray600}"
                           Margin="4,4,0,0" />

                    <!-- Results are capped (30) in SQL; the list virtualises inside its own viewport. -->
                    <CollectionView ItemsSource="{Binding CustomerResults}"
                                    IsVisible="{Binding ShowResults}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedPickRow}"
                                    HeightRequest="360"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    AutomationId="CustomerResultsList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerPickRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                      Padding="8,8" MinimumHeightRequest="56"
                                      BackgroundColor="White"
                                      SemanticProperties.Description="{Binding Name}">
                                    <Border Grid.Column="0"
                                            WidthRequest="40" HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource Gray200}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Initials}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Charcoal}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label FormattedText="{Binding NameFormatted}"
                                               FontSize="16"
                                               TextColor="{StaticResource Charcoal}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PhoneDisplay}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray600}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- No matches: offer to create the customer from what was typed -->
                    <VerticalStackLayout IsVisible="{Binding ShowNoMatches}" Spacing="8" Padding="4,8">
                        <Label Text="{Binding NoMatchesText}"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}" />
                        <Button Text="Add new customer"
                                ImageSource="{mi:Material Icon=PersonAdd, IconColor=White}"
                                Command="{Binding AddNewCustomerCommand}"
                                TextColor="White"
                                HeightRequest="48"
                                AutomationId="AddNewCustomerButton"
                                SemanticProperties.Description="Add new customer" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Step 2: Garments -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStepGarment}">
                <Label Text="Add garments"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{StaticResource Charcoal}" />

                <Label Text="Template" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <Picker Title="Garment template"
                        ItemsSource="{Binding TemplateChoices}"
                        ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:TemplateChoice}"
                        SelectedItem="{Binding SelectedTemplate}"
                        TextColor="{StaticResource Charcoal}"
                        BackgroundColor="White"
                        HeightRequest="48" />

                <Label Text="Measurement snapshot (optional)"
                       FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <Picker Title="Snap from measurement"
                        ItemsSource="{Binding Measurements}"
                        ItemDisplayBinding="{Binding GarmentTemplateDisplay, x:DataType=meas:MeasurementListItemDto}"
                        SelectedItem="{Binding SelectedMeasurement}"
                        TextColor="{StaticResource Charcoal}"
                        BackgroundColor="White"
                        HeightRequest="48" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Qty" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                        <Entry Text="{Binding QuantityText}"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               HeightRequest="48"
                               TextColor="{StaticResource Charcoal}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Unit price (GH₵)" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                        <Entry Text="{Binding UnitPriceText}"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               HeightRequest="48"
                               TextColor="{StaticResource Charcoal}" />
                    </VerticalStackLayout>
                </Grid>

                <Button Style="{StaticResource SecondaryButton}"
                        Text="Add garment line"
                        Command="{Binding AddLineCommand}"
                        HeightRequest="48"
                        IsEnabled="{Binding CanSubmit}" />

                <CollectionView ItemsSource="{Binding Lines}" HeightRequest="180" IsVisible="{Binding HasLines}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CreateOrderLineDraft">
                            <Grid Padding="0,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding LineSummary}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Charcoal}" />
                                    <Label Text="{Binding SnapshotLabel}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Remove"
                                        Command="{Binding RemoveCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource SemanticError}"
                                        HeightRequest="48"
                                        MinimumWidthRequest="48"
                                        SemanticProperties.Description="Remove garment line" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Step 3: Details -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsStepDetails}">
                <Label Text="Price &amp; due date"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{StaticResource Charcoal}" />

                <Label Text="Total" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <Label Text="{Binding TotalAmountText}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Charcoal}"
                       SemanticProperties.Description="Order total, sum of garment lines" />
                <Label Text="Worked out from the garments above."
                       FontSize="13"
                       TextColor="{StaticResource Gray600}" />

                <HorizontalStackLayout Spacing="8">
                    <CheckBox IsChecked="{Binding HasDueDate}" Color="{StaticResource Primary}" />
                    <Label Text="Set due date" VerticalOptions="Center" TextColor="{StaticResource Charcoal}" />
                </HorizontalStackLayout>
                <DatePicker Date="{Binding DueDate}"
                            IsEnabled="{Binding HasDueDate}"
                            TextColor="{StaticResource Charcoal}"
                            BackgroundColor="White" />

                <Label Text="Notes" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <Editor Text="{Binding Notes}"
                        Placeholder="Style notes, fabric…"
                        AutoSize="TextChanges"
                        MaxLength="2000"
                        BackgroundColor="White"
                        TextColor="{StaticResource Charcoal}"
                        HeightRequest="80" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,12,0,0">
                <Button Grid.Column="0"
                        Text="Previous"
                        Command="{Binding BackStepCommand}"
                        IsVisible="{Binding ShowBackStep}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Charcoal}"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="{Binding PrimaryButtonText}"
                        Command="{Binding PrimaryCommand}"
                        TextColor="White"
                        HeightRequest="48"
                        IsEnabled="{Binding CanSubmit}"
                        SemanticProperties.Description="Continue or create order" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
