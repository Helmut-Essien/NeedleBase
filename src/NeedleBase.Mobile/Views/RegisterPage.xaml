<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             x:Class="NeedleBase.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,28" Spacing="0">
            <Image Source="needlebase_logo.png"
                   Aspect="AspectFit"
                   HeightRequest="176"
                   WidthRequest="320"
                   HorizontalOptions="Center"
                   Margin="0,0,0,12"
                   SemanticProperties.Description="NeedleBase logo" />

            <Label Text="Register your business"
                   TextColor="{StaticResource Charcoal}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Create an owner account for NeedleBase"
                   TextColor="{StaticResource Gray600}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   Margin="0,4,0,20" />

            <Label Text="First name" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="{StaticResource White}"
                    Padding="14,2" MinimumHeightRequest="48" StrokeShape="RoundRectangle 8" Margin="0,0,0,14">
                <Entry Placeholder="First name"
                       PlaceholderColor="{StaticResource Gray600}"
                       TextColor="{StaticResource Charcoal}"
                       Text="{Binding FirstName}"
                       IsEnabled="{Binding CanSubmit}"
                       SemanticProperties.Description="First name" />
            </Border>

            <Label Text="Surname" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="{StaticResource White}"
                    Padding="14,2" MinimumHeightRequest="48" StrokeShape="RoundRectangle 8" Margin="0,0,0,14">
                <Entry Placeholder="Surname"
                       PlaceholderColor="{StaticResource Gray600}"
                       TextColor="{StaticResource Charcoal}"
                       Text="{Binding Surname}"
                       IsEnabled="{Binding CanSubmit}"
                       SemanticProperties.Description="Surname" />
            </Border>

            <Label Text="Business name" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="{StaticResource White}"
                    Padding="14,2" MinimumHeightRequest="48" StrokeShape="RoundRectangle 8" Margin="0,0,0,14">
                <Entry Placeholder="e.g. Ama Stitches"
                       PlaceholderColor="{StaticResource Gray600}"
                       TextColor="{StaticResource Charcoal}"
                       Text="{Binding BusinessName}"
                       IsEnabled="{Binding CanSubmit}"
                       SemanticProperties.Description="Business name"
                       AutomationId="RegisterBusinessName" />
            </Border>

            <Label Text="Business phone (optional)" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="{StaticResource White}"
                    Padding="14,2" MinimumHeightRequest="48" StrokeShape="RoundRectangle 8" Margin="0,0,0,14">
                <Entry Placeholder="+233..."
                       PlaceholderColor="{StaticResource Gray600}"
                       TextColor="{StaticResource Charcoal}"
                       Text="{Binding BusinessPhone}"
                       Keyboard="Telephone"
                       IsEnabled="{Binding CanSubmit}"
                       SemanticProperties.Description="Business phone optional" />
            </Border>

            <Label Text="Email" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="{StaticResource White}"
                    Padding="14,2" MinimumHeightRequest="48" StrokeShape="RoundRectangle 8" Margin="0,0,0,14">
                <Entry Placeholder="you@business.com"
                       PlaceholderColor="{StaticResource Gray600}"
                       TextColor="{StaticResource Charcoal}"
                       Text="{Binding Email}"
                       Keyboard="Email"
                       IsEnabled="{Binding CanSubmit}"
                       SemanticProperties.Description="Email address"
                       AutomationId="RegisterEmail" />
            </Border>

            <Label Text="Password" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,2,4,2"
                    MinimumHeightRequest="48"
                    StrokeShape="RoundRectangle 8">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding HasPasswordError}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource SemanticError}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0"
                           Placeholder="Create a password"
                           PlaceholderColor="{StaticResource Gray600}"
                           TextColor="{StaticResource Charcoal}"
                           Text="{Binding Password}"
                           IsPassword="{Binding IsPasswordHidden}"
                           IsEnabled="{Binding CanSubmit}"
                           SemanticProperties.Description="Password: at least six characters, with a number and a small letter"
                           AutomationId="RegisterPassword" />
                    <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                        <Image WidthRequest="21" HeightRequest="21" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsPasswordHidden}" AutomationProperties.IsInAccessibleTree="False">
                            <Image.Source>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=VisibilityOff}" Color="{StaticResource Gray600}" Size="21" />
                            </Image.Source>
                        </Image>
                        <Image WidthRequest="21" HeightRequest="21" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsPasswordVisible}" AutomationProperties.IsInAccessibleTree="False">
                            <Image.Source>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=Visibility}" Color="{StaticResource Gray600}" Size="21" />
                            </Image.Source>
                        </Image>
                        <Button BackgroundColor="Transparent" BorderWidth="0" WidthRequest="44" HeightRequest="44"
                                MinimumWidthRequest="44" MinimumHeightRequest="44" Padding="0" CornerRadius="22"
                                Command="{Binding TogglePasswordVisibilityCommand}" IsEnabled="{Binding CanSubmit}"
                                SemanticProperties.Description="{Binding PasswordToggleDescription}"
                                AutomationId="RegisterPasswordToggle" />
                    </Grid>
                </Grid>
            </Border>
            <Label Text="{Binding PasswordError}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasPasswordError}"
                   FontSize="13"
                   Margin="0,6,0,0"
                   SemanticProperties.Description="Password error" LineBreakMode="WordWrap" />
            <Label Text="{x:Static vm:PasswordRules.Hint}"
                   TextColor="{StaticResource Gray600}"
                   FontSize="13"
                   Margin="0,6,0,14">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HasPasswordError}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Label Text="Confirm password" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" Margin="0,0,0,6" />
            <Border x:Name="ConfirmPasswordBorder"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,2,4,2"
                    MinimumHeightRequest="48"
                    StrokeShape="RoundRectangle 8"
                    Margin="0,0,0,6">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding HasConfirmPasswordError}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource SemanticError}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0"
                           Placeholder="Confirm your password"
                           PlaceholderColor="{StaticResource Gray600}"
                           TextColor="{StaticResource Charcoal}"
                           Text="{Binding ConfirmPassword}"
                           IsPassword="{Binding IsConfirmPasswordHidden}"
                           IsEnabled="{Binding CanSubmit}"
                           SemanticProperties.Description="Confirm password" />
                    <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                        <Image WidthRequest="21" HeightRequest="21" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsConfirmPasswordHidden}" AutomationProperties.IsInAccessibleTree="False">
                            <Image.Source>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=VisibilityOff}" Color="{StaticResource Gray600}" Size="21" />
                            </Image.Source>
                        </Image>
                        <Image WidthRequest="21" HeightRequest="21" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsConfirmPasswordVisible}" AutomationProperties.IsInAccessibleTree="False">
                            <Image.Source>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=Visibility}" Color="{StaticResource Gray600}" Size="21" />
                            </Image.Source>
                        </Image>
                        <Button BackgroundColor="Transparent" BorderWidth="0" WidthRequest="44" HeightRequest="44"
                                MinimumWidthRequest="44" MinimumHeightRequest="44" Padding="0" CornerRadius="22"
                                Command="{Binding ToggleConfirmPasswordVisibilityCommand}" IsEnabled="{Binding CanSubmit}"
                                SemanticProperties.Description="{Binding ConfirmPasswordToggleDescription}"
                                AutomationId="RegisterConfirmPasswordToggle" />
                    </Grid>
                </Grid>
            </Border>
            <Label Text="{Binding ConfirmPasswordError}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasConfirmPasswordError}"
                   FontSize="13"
                   Margin="0,0,0,8"
                   SemanticProperties.Description="Confirm password error" LineBreakMode="WordWrap" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasError}"
                   FontSize="13"
                   Margin="0,0,0,8"
                   SemanticProperties.Description="Registration error" LineBreakMode="WordWrap" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               Margin="0,0,0,8" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,4,0,8">
                <CheckBox Grid.Row="0" Grid.Column="0"
                          IsChecked="{Binding AcceptTerms}"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Start"
                          SemanticProperties.Description="I agree to the Terms and Conditions and Privacy Policy"
                          AutomationId="RegisterAcceptTerms" />
                <Label Grid.Row="0" Grid.Column="1"
                       FontSize="14"
                       TextColor="{StaticResource Charcoal}"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Start"
                       SemanticProperties.Description="I agree to the Terms and Conditions and Privacy Policy">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="I agree to the " />
                            <Span Text="Terms and Conditions" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTermsClicked" />
                                </Span.GestureRecognizers>
                            </Span>
                            <Span Text=" and " />
                            <Span Text="Privacy Policy" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyClicked" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding TermsError}"
                       TextColor="{StaticResource SemanticError}"
                       IsVisible="{Binding HasTermsError}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       Margin="0,4,0,0"
                       SemanticProperties.Description="Terms agreement error" />
            </Grid>

            <Button Text="Create business"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    TextColor="{StaticResource White}"
                    CornerRadius="10"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,8,0,12"
                    SemanticProperties.Description="Create business account"
                    AutomationId="RegisterSubmit" />

            <HorizontalStackLayout Spacing="0" HorizontalOptions="Center" Margin="0,4,0,24">
                <Label Text="Already have an account?"
                       TextColor="{StaticResource Gray600}"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Button Text="Sign in"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="48"
                        MinimumHeightRequest="48"
                        MinimumWidthRequest="72"
                        Padding="8,0"
                        Margin="0"
                        IsEnabled="{Binding CanSubmit}"
                        Clicked="OnLoginClicked"
                        SemanticProperties.Description="Back to sign in"
                        AutomationId="RegisterGoToLogin" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
