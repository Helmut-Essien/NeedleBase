<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             x:Class="NeedleBase.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Register your business"
                   TextColor="{StaticResource Charcoal}"
                   FontSize="24"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Business name" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
            <Entry Placeholder="e.g. Ama Stitches"
                   Text="{Binding BusinessName}"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Business name"
                   AutomationId="RegisterBusinessName" />

            <Label Text="Business phone (optional)" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
            <Entry Placeholder="+233…"
                   Text="{Binding BusinessPhone}"
                   Keyboard="Telephone"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Business phone optional" />

            <Label Text="First name" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
            <Entry Placeholder="First name"
                   Text="{Binding FirstName}"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="First name" />

            <Label Text="Surname" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
            <Entry Placeholder="Surname"
                   Text="{Binding Surname}"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Surname" />

            <Label Text="Email" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
            <Entry Placeholder="you@business.com"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Email address"
                   AutomationId="RegisterEmail" />

            <Label Text="Password" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
            <Entry Placeholder="At least 6 characters"
                   Text="{Binding Password}"
                   IsPassword="True"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Password minimum six characters"
                   AutomationId="RegisterPassword" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasError}"
                   SemanticProperties.Description="Registration error" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Create business"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    SemanticProperties.Description="Create business account"
                    AutomationId="RegisterSubmit" />
            <Button Text="Back to sign in"
                    BackgroundColor="{StaticResource PrimaryLight}"
                    TextColor="{StaticResource Charcoal}"
                    IsEnabled="{Binding CanSubmit}"
                    Clicked="OnLoginClicked"
                    SemanticProperties.Description="Back to sign in" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
