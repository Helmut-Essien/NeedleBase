<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             x:Class="NeedleBase.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource AppBackground}">

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="{Binding Title}"
               TextColor="{StaticResource Charcoal}"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               SemanticProperties.HeadingLevel="Level1"
               SemanticProperties.Description="NeedleBase app home" />
        <Label Text="{Binding Tagline}"
               TextColor="{StaticResource Gray600}"
               FontSize="16"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"
               SemanticProperties.Description="{Binding Tagline}" />
    </VerticalStackLayout>

</ContentPage>
