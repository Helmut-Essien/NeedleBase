<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             x:Class="NeedleBase.Mobile.Views.MeasurementEditPage"
             x:DataType="vm:MeasurementEditViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,40,16,12" Spacing="12">
                <Button Text="Back"
                        ImageSource="{mi:Material Icon=ArrowBack, IconColor={StaticResource Charcoal}}"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Charcoal}"
                        HorizontalOptions="Start"
                        HeightRequest="48"
                        Padding="0,0,12,0"
                        SemanticProperties.Description="Go back" />
                <Label Text="{Binding Title}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Charcoal}"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Garment template"
                       TextColor="{StaticResource Charcoal}" FontAttributes="Bold"
                       FontSize="14" />
                <Picker ItemsSource="{Binding TemplateChoices}"
                        ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:TemplateChoice}"
                        SelectedItem="{Binding SelectedTemplate}"
                        TextColor="{StaticResource Charcoal}"
                        TitleColor="{StaticResource Gray600}"
                        HeightRequest="48"
                        BackgroundColor="White"
                        IsEnabled="{Binding CanSave}"
                        SemanticProperties.Description="Garment measurement template" />

                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="{Binding UnitLabel, StringFormat='Unit: {0}'}"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Charcoal}"
                           SemanticProperties.Description="Current measurement unit" />
                    <Switch IsToggled="{Binding UseInches}"
                            IsEnabled="{Binding CanSave}"
                            SemanticProperties.Description="Toggle between centimetres and inches" />
                    <Label Text="Use inches"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Gray600}" />
                </HorizontalStackLayout>

                <Label Text="Measurements"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{StaticResource Charcoal}"
                       Margin="0,8,0,0"
                       SemanticProperties.HeadingLevel="Level2" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MeasurementFieldItem">
                            <Grid ColumnDefinitions="*,100,36"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8"
                                  Padding="0,6">
                                <Label Grid.Column="0"
                                       Text="{Binding Label}"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Charcoal}" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ValueText}"
                                       Keyboard="Numeric"
                                       Placeholder="0"
                                       PlaceholderColor="{StaticResource Gray600}"
                                       TextColor="{StaticResource Charcoal}"
                                       HeightRequest="48"
                                       BackgroundColor="White"
                                       HorizontalTextAlignment="End"
                                       IsEnabled="{Binding IsEnabled}"
                                       SemanticProperties.Description="{Binding Label}" />
                                <Label Grid.Column="2"
                                       Text="{Binding UnitSuffix}"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray600}" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding Error}"
                                       TextColor="{StaticResource SemanticError}"
                                       IsVisible="{Binding HasError}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap"
                                       SemanticProperties.Description="Measurement value error" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Notes (optional)"
                       TextColor="{StaticResource Gray600}"
                       FontSize="13"
                       Margin="0,8,0,0" />
                <Editor Text="{Binding Notes}"
                        Placeholder="Optional notes"
                        PlaceholderColor="{StaticResource Gray600}"
                        TextColor="{StaticResource Charcoal}"
                        AutoSize="TextChanges"
                        MaxLength="2000"
                        BackgroundColor="White"
                        HeightRequest="80"
                        IsEnabled="{Binding CanSave}"
                        SemanticProperties.Description="Optional measurement notes" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource SemanticError}"
                       IsVisible="{Binding HasError}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       SemanticProperties.Description="Measurement save error" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="Save"
                HeightRequest="48"
                CornerRadius="10"
                FontSize="16"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}"
                TextColor="White"
                IsEnabled="{Binding CanSave}"
                Margin="16,8,16,20"
                SemanticProperties.Description="Save measurements on this device" />
    </Grid>
</ContentPage>
