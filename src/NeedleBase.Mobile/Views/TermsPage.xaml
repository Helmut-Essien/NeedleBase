<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NeedleBase.Mobile.Views.TermsPage"
             Title="Terms and Conditions"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,32" Spacing="10">
            <Label Text="NeedleBase Terms and Conditions" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Operator: HelmutCode Solutions (&quot;HelmutCode&quot;, &quot;we&quot;, &quot;us&quot;), operator of NeedleBase." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Registered/business address: YN13 Flask Street, Ghana" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Contact: email helmutessien@gmail.com; WhatsApp +233 50 078 5153 (https://wa.me/233500785153)" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Effective date: 1 January 2027" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Last updated: 13 November 2026" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="1. Definitions" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="•  NeedleBase / the Service: the NeedleBase software for tailors, seamstresses, dressmakers and fashion workshop owners, including the Android app, the website, and the application programming interface (API) that syncs them." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Business: a tailoring or fashion workshop that registers for NeedleBase." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Owner: the person who registers a Business and controls its account. Staff: people the Business authorises under roles such as Owner, Manager or Tailor." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Business Data: information entered by or for a Business, including customer records, body measurements, sewing orders and payment records." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Licence key: a key issued for a Business that allows it to use the Service, and that may carry a plan, a trial or complimentary period, or an expiry date." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Personal data has the meaning in the Data Protection Act, 2012 (Act 843): data about an individual who can be identified from that data, or from that data and other information." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="2. The Service" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="2.1 NeedleBase helps a Business manage customers, measurements, sewing orders (from new order through cutting, sewing, fitting and readiness to collection) and records of payments made to the Business." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="2.2 The Service is offline-first. The mobile app can store Business Data on the device in a local database (SQLite). That on-device copy is not encrypted at rest by the app. Data is synced to our API and hosted database when an internet connection is available. Syncing may be delayed by connectivity, device or service problems; the Business should check important orders and payments after reconnecting, protect phones with a screen lock, and keep its own backups of anything that has not yet synced. A lost, stolen or reset phone may still hold unsynced records that exist only on that device." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="2.3 We will use reasonable efforts to keep the Service available and secure, but we do not guarantee uninterrupted or error-free availability. Features may change as the Service develops, and some planned features (including any export tool) are not promised unless we state in writing that they are available." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="2.4 Electronic acceptance: an agreement may be formed electronically. The Electronic Transactions Act, 2008 (Act 772) recognises electronic records and agreements (including sections 5 to 8 on electronic records and retention, section 17 on automated transactions and section 23 on formation and validity of agreements). By ticking the acceptance box and creating an account you agree to these Terms and to the Privacy Policy; please save or print a copy for your records (see Act 772, section 47 on information to be provided in electronic transactions, where it applies)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="3. Eligibility and accounts" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="3.1 You must be 18 years or older and have authority to act for the Business you register. The Owner is responsible for the accuracy of the Business information supplied." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="3.2 The Owner controls Staff accounts and roles. Owners and Managers must only give access to people who need it, must keep passwords private, and must remove access promptly when a person leaves the Business. Tailor accounts, as designed, have narrower access; role settings do not replace the Business&#x27;s own supervision." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="3.3 You are responsible for activity under your Business&#x27;s accounts, and must notify us promptly at helmutessien@gmail.com or on WhatsApp +233 50 078 5153 if you suspect unauthorised access." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4. Fees, sample prices and licence keys" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="4.1 There is no in-app billing in the current product. NeedleBase does not take card, mobile money or bank payments for a subscription inside the app or the website." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4.2 The public website may show sample plan prices (for example monthly and yearly figures in Ghana cedis). Those figures are illustrations only until we confirm them to you in writing. They are not an offer, and they are not a price promised in these Terms." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4.3 Access to the Service for a Business is granted with a licence key. New shops must normally enter a licence key when they register. Keys are agreed and issued off the app, after you contact us by WhatsApp or email, and are then entered in NeedleBase. The server stores the key in a protected (encrypted) form and may check the key&#x27;s status with NeedleBase&#x27;s licensing service. A key may have a plan, a trial period, a complimentary period, or an expiry date. If a key is no longer valid, the Business may have a short grace period (currently seven days after the licensing service first says the key is not valid) before access is limited." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4.4 The fee for a key or plan, and any refund, are as agreed in writing when the key is issued (for example in our WhatsApp or email messages with you). These Terms do not add a separate refund percentage or cooling-off period. Nothing in this clause takes away any right that Ghana law says you cannot give up." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4.5 If we later add paid plans or in-app billing, we will give reasonable prior notice (normally at least 30 days) of the price, what it covers and when it starts. A paid plan will not start for your Business until you accept it. Taxes or charges imposed by law, if they apply, will be shown as required." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4.6 A Business remains responsible for its own taxes, invoices, receipts and filings with the Ghana Revenue Authority and other authorities. Payment records in NeedleBase are business records; they are not tax invoices unless the Business separately issues a valid invoice." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="5. Payment records — NeedleBase is not a payment service provider" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="5.1 NeedleBase records payments that a Business says it has received — for example cash, mobile money (MoMo) or bank payment, in Ghana cedis (GHS). It does not receive, hold, transfer, settle or guarantee money, does not issue electronic money or payment instruments, and does not process MoMo or bank payments." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="5.2 Under the Payment Systems and Services Act, 2019 (Act 987), a body corporate must hold a Bank of Ghana payment system licence before operating as a payment service provider (see section 7). NeedleBase as described in these Terms does not carry on that licensed activity. MoMo providers, banks and other payment providers are third parties with their own terms; disputes about an actual transfer of money are between the Business, its customer and that provider." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="5.3 If NeedleBase ever adds collection, payout or other payment services, those features would require separate terms and, where applicable, Bank of Ghana licensing or authorisation before launch." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="6. Business Data and ownership" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="6.1 As between the parties, the Business owns its Business Data. You grant HelmutCode Solutions a limited licence to host, copy, transmit, display and process Business Data only to provide, secure and maintain the Service, and as otherwise described in the Privacy Policy." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="6.2 You are responsible for the accuracy and lawfulness of Business Data, for having the right to enter customer information, and for keeping your own backups where you need them. Do not enter information the Business has no right to record." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7. Data protection (Act 843)" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="7.1 For customer and Staff personal data entered by a Business: the Business is the data controller (it decides why and how the data is used) and HelmutCode Solutions is a data processor / service provider acting on the Business&#x27;s instructions. This reflects Act 843, including section 29 (a processor must process only with the controller&#x27;s knowledge or authorisation and keep data confidential) and section 30 (controller–processor processing should be governed by a written contract with confidentiality and security measures). These Terms, with the Privacy Policy, form that written arrangement for the Service." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7.2 Registration. A data controller who intends to process personal data must register with the Data Protection Commission (Act 843, sections 27, 46 and 53; registration is renewed every two years under section 50). Each Business must assess and, where required, complete its own registration. HelmutCode Solutions is not registered with the Data Protection Commission. A person may complain to the Commission about the handling of their personal data (see dataprotection.org.gh (https://dataprotection.org.gh) / dpc.gov.gh (https://dpc.gov.gh))." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7.3 Safeguards. Each party will apply appropriate, reasonable technical and organisational measures consistent with Act 843, section 28 (security measures) and section 30 — including access controls by role, hashed passwords and secure sign-in, a protected licence key, and keeping safeguards under review. The copy of Business Data on a phone is not encrypted by the app itself (see clause 2.2)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7.4 Security incidents. Act 843, section 31 requires notification to the Commission and affected data subjects, as soon as reasonably practicable, where there are reasonable grounds to believe personal data has been accessed or acquired by an unauthorised person. If HelmutCode Solutions becomes aware of such an incident affecting Business Data, we will notify the affected Business (normally the Owner) without undue delay and cooperate on investigation and restoration, and the Business (as controller) remains responsible for notifying the Commission and customers where the law requires it. Businesses must promptly pass to us any relevant incident they discover on their own devices. The Cybersecurity Act, 2020 (Act 1038) imposes additional incident duties on owners of designated critical information infrastructure and certain institutions (see sections 39 and 47); NeedleBase is not designated as critical information infrastructure at the date of these Terms, and we will comply with any cybersecurity duty that applies to us." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7.5 Data subject requests. Customers may exercise rights under Act 843 (including access and correction under sections 32, 33 and 35, objection under section 20, and the right to require a controller to stop processing that causes unwarranted damage or distress under section 39). The Business, as controller, must answer those requests; we will provide reasonable assistance (for example by making the relevant records available through the Service or, on a verified Owner request, correcting or deleting records we hold as processor) so the Business can respond in time." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7.6 Where data is processed. Business Data may be stored on the user&#x27;s device and synced to hosting used for the API and database. The website, API and database are hosted with MonsterASP.NET in Europe, and the public site is at https://needlebase.runasp.net/ (https://needlebase.runasp.net/). Personal data held on the hosted service is therefore stored in Europe and is transferred outside Ghana. Hosting and other sub-processors are described in the Privacy Policy." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="8. Acceptable use" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="You must not: use the Service unlawfully or for another person&#x27;s business without authority; access or attempt to access another Business&#x27;s data; share accounts in a way that defeats role controls; upload malicious code or disrupt the Service; copy or reverse-engineer the Service except as permitted by law; use customer data for unsolicited direct marketing without the customer&#x27;s prior written consent (see Act 843, section 40); or enter special personal data (Act 843, section 37 — for example health, religious, political or criminal-record information) that the Business does not lawfully need for tailoring." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="9. Intellectual property" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="9.1 HelmutCode Solutions (and its licensors) own the NeedleBase software, brand, documentation and all intellectual property in the Service, except Business Data. Subject to these Terms, we grant the Business a non-exclusive, non-transferable, revocable licence to use the Service for its internal business while its account is active and its licence key remains valid (including any applicable grace period)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="9.2 If you send ideas or feedback, we may use it without payment or attribution to improve the Service, provided we do not disclose your Business Data as part of doing so." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="10. Third-party services" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="The Service works alongside third parties, including: device makers; internet providers; MoMo providers and banks (for money the Business collects itself); app stores; the hosting provider (MonsterASP.NET, in Europe); NeedleBase&#x27;s licensing service, for licence-key checks; Gmail SMTP or Resend, which we use to send email (password-reset and optional staff-invite messages); and Meta (WhatsApp Cloud API) when a Business turns on WhatsApp order notices and a customer has opted in — in that case the customer&#x27;s number and the notice can be processed by Meta under Meta&#x27;s own terms. The public website may also offer a WhatsApp &quot;click to chat&quot; link so you can message us; that is a link you choose to open." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="We are not responsible for those third parties&#x27; services, charges, outages or terms. Links or references do not imply endorsement." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="11. Disclaimers and limitation of liability" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="11.1 The Service is provided &quot;as is&quot; and &quot;as available&quot;. To the fullest extent permitted by Ghana law, we exclude implied warranties that the Service will be uninterrupted, error-free or fit for a particular purpose. Nothing in these Terms excludes or limits: liability for fraud or wilful misconduct; liability for death or personal injury caused by negligence; a data subject&#x27;s rights or compensation under Act 843 (including section 43); or any consumer right that cannot be excluded (see Act 772, section 54, where it applies). A clause excluding such rights would be void to that extent." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="11.2 Subject to clause 11.1, neither party is liable for indirect or consequential loss, loss of profit, loss of goodwill, or loss caused by incorrect Business Data, a lost device, failure to sync, or a third-party payment failure. Each Business should verify measurements, orders and payments before relying on them." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="11.3 Subject to clause 11.1, our total liability to you for claims arising out of these Terms or the Service is limited to the licence fees you paid us in the 12 months before the claim, except where Ghana law does not allow that limit." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="12. Suspension, termination and what happens to data" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="12.1 The Owner may stop using the Service at any time. We may suspend or terminate access where an account is used unlawfully, creates a security risk, or materially breaches these Terms, or where the licence key is no longer valid and any grace period has ended; where practicable we will give notice and a chance to remedy first." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="12.2 You can delete your account in the NeedleBase app (More → Delete account) or on the website at /account/delete, after confirming your password. A staff member's deletion removes only their sign-in account; the shop's records stay. If the Owner deletes their account, the shop is closed at once: everyone is signed out and cannot sign in, and we delete the shop's hosted records (customers, measurements, orders, payments, WhatsApp settings and staff sign-in accounts) at once, except the activity log, which is kept for up to 730 days, and except where the law requires or allows us to keep something, or the data is reasonably needed to resolve a dispute or enforce these Terms. If you cannot sign in, you may ask us by email or WhatsApp; after we have verified the request, we will normally action it within 30 days. Data stored only on a workshop's own device is not deleted by this — it remains the workshop's responsibility." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="12.3 If a Business simply stops using the Service without asking us to delete the account, we keep the Business Data we hold on the hosted service for one year after use stops, and then we delete it, except where the law requires or allows us to keep something. The server audit log is deleted after 730 days (two years) by default, which is a separate period and may run longer or shorter than the one-year shop-data period. Data stored only on a Business&#x27;s own device remains the Business&#x27;s responsibility." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="12.4 On a verified written request from the Owner we will also, within a reasonable period (normally within 30 days), make Business Data held in our systems available in a reasonable manner, except where the law does not allow that. We do not promise a particular export format. Act 772, section 8 addresses retention of electronic records where a law requires retention." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="12.5 Clauses that by their nature should survive termination (ownership, data protection, liability, governing law) survive." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="13. Changes to these Terms" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="We may update these Terms as the Service or the law changes. We will post the updated version with a new &quot;Last updated&quot; date and give reasonable notice of material changes through the Service or by email. Continued use after the effective date of the update is acceptance of the updated Terms; if a Business does not accept a material change, it may stop using the Service before that date." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="14. Governing law and disputes" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="14.1 These Terms are governed by the laws of the Republic of Ghana." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="14.2 The parties will first try in good faith to resolve a dispute by negotiation (normally within 14 days of written notice). If not resolved, they will attempt mediation in Accra, Ghana. If mediation does not resolve it (or a party needs urgent court relief), the courts of Ghana have jurisdiction. Nothing in this clause prevents a complaint to the Data Protection Commission under Act 843 or a complaint to any regulator with authority over the matter." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="15. General and contact" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="15.1 If a clause is unenforceable, the rest continue in force. Failure to enforce a clause is not a waiver. You may not transfer your account without our written consent; we may transfer our rights or obligations in connection with a reorganisation of the operator, with notice." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="15.2 Questions about these Terms, or requests to delete an account or a copy of the data we hold, should be sent to HelmutCode Solutions, YN13 Flask Street, Ghana. Email: helmutessien@gmail.com. WhatsApp: +233 50 078 5153 (https://wa.me/233500785153). The same contacts are the data-protection contact for HelmutCode Solutions." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="15.3 HelmutCode is the brand name used in the app. The legal operator is HelmutCode Solutions." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="The Privacy Policy is at https://needlebase.runasp.net/Privacy (https://needlebase.runasp.net/Privacy) and in the NeedleBase phone app." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Button Text="Back" TextColor="{StaticResource White}" CornerRadius="10" HeightRequest="48" FontAttributes="Bold" FontSize="16" Margin="0,16,0,0" Clicked="OnBackClicked" SemanticProperties.Description="Go back" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
