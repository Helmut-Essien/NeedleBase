<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NeedleBase.Mobile.Views.PrivacyPage"
             Title="Privacy Policy"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,32" Spacing="10">
            <Label Text="NeedleBase Privacy Policy" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Operator: HelmutCode [full legal name of operator to be inserted] (&quot;HelmutCode&quot;, &quot;we&quot;), operator of NeedleBase." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Contact / data-protection contact: [contact email to be inserted]" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Last updated: 19 October 2026" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Draft for review by a qualified Ghanaian lawyer. It is not legal advice." FontSize="13" FontAttributes="Italic" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" />
            <Label Text="NeedleBase is an offline-first tailoring-business app for Ghanaian and West African workshops. This Policy explains, in plain language, what personal data is involved, why, and the rights people have under the Data Protection Act, 2012 (Act 843)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="1. Roles: who decides what" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="•  A tailoring Business (and its Owner) decides why customer and Staff information is entered into NeedleBase. For that information the Business is the data controller under Act 843." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  HelmutCode/NeedleBase is mainly a data processor / service provider: we host, store and sync that information on the Business&#x27;s instructions (see Act 843, sections 29 and 30). These arrangements are recorded in the Terms and Conditions." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  HelmutCode is a data controller for a narrower set of data we decide about ourselves: Business account registration, Owner/Staff sign-in, support communications and keeping the Service secure." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="2. Personal data involved" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="•  Account and Staff data: names, email addresses, roles (Owner/Manager/Tailor), Business name and phone, and sign-in credentials handled by the sign-in system (passwords are not visible to other users)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Customer data entered by a Business: customer names and contact details, body measurements and order-related notes. Measurements are personal data because they relate to an identified customer; a Business should only record measurements needed for an order and should not record health or other sensitive information in measurement or notes fields." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Order data: garments, order progress (new, cutting, sewing, fitting, ready, collected), dates, prices and staff assignments, where linked to a customer." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Payment records: amounts in GHS, method recorded (cash, MoMo or bank), dates and the order they relate to. NeedleBase records that a Business says a payment happened; it does not process the MoMo/bank transfer and does not store MoMo PINs or bank passwords. Do not enter anyone&#x27;s PIN or full bank credentials." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Technical data: device/app sync and diagnostic information reasonably needed to run and secure the Service." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="3. Purposes and lawful grounds (Act 843)" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="Act 843, section 17 sets principles including accountability, lawfulness, purpose specification, quality, openness, security safeguards and data subject participation. Section 20 provides that personal data is processed with the data subject&#x27;s consent unless processing is necessary for a contract with the data subject, authorised or required by law, to protect a legitimate interest of the data subject, for a statutory duty, or to pursue a legitimate interest of the controller or a third party to whom data is supplied." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="We and Businesses use the data above to: create and secure accounts; record customers, measurements and orders; track production; record payments; sync devices; provide support; and keep the Service safe. The main grounds relied on are performance of the Business&#x27;s contract with its customer (and our contract with the Business), legitimate interests in running and securing a workshop system, legal obligations where they apply, and consent where a Business or person has given it (for example for optional communications). A person may object to processing under section 20; a Business as controller must handle objections that apply to its customer data." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Keeping data accurate, complete and not misleading matters (Act 843, section 26), and only data that is necessary, relevant and not excessive should be processed (section 19)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="4. Offline storage and syncing" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="NeedleBase is offline-first. Customer, measurement, order and payment information may be stored in a local database on the phone/device first and synced to the NeedleBase API and its database (PostgreSQL) when the device is online. A customer&#x27;s information may therefore exist both on the Business&#x27;s device and in the hosted Service. Protect devices with a screen lock, app sign-in and role-based access; a lost device should be reported to the Business Owner promptly." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="5. Sharing — no sale of personal data" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="•  We do not sell personal data. Selling personal data is an offence under Act 843, section 89." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  We share data only: within a Business to its authorised Staff according to role; with hosting, database, communications and other sub-processors/providers reasonably needed to operate and secure the Service (in general terms: cloud/hosting and email/support providers, [hosting provider/region to be inserted]); where a Business instructs us; and where disclosure is required by law, court order or a regulator." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  MoMo providers and banks are independent third parties for the actual movement of money; NeedleBase does not give them customer measurement data." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Hosting may involve processing outside Ghana. Act 843 does not set out a single transfer-approval chapter in the text relied on for this Policy, but registration particulars can include the country to which data may be transferred (section 47(1)(g)) and a controller must ensure a non-Ghana-domiciled processor complies with Ghana law (section 30(4)). We will take reasonable contractual and security steps for any such processing and update this Policy if our hosting region changes materially." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="6. Retention" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="We and Businesses should not keep personal data longer than necessary for the purpose it was collected, unless retention is required/authorised by law, reasonably necessary for a lawful purpose connected with the Business, required by contract, or the data subject consents (Act 843, section 24). At the end of the retention period records should be deleted, destroyed or de-identified in a way that prevents reconstruction. The current product has no self-service export/deletion portal for a whole Business account: an Owner may ask us in writing at [contact email] and we will normally action a verified deletion request within 30 days, subject to lawful retention (for example where a law requires records to be kept — Act 772, section 8 deals with electronic retention where retention is required)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="7. Security" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="We apply appropriate, reasonable technical and organisational measures consistent with Act 843, section 28 — such as role-based access (Owner/Manager/Tailor), authenticated sign-in, secure transport for sync where configured, and limiting Staff access. No system is completely secure. If there are reasonable grounds to believe personal data has been accessed or acquired by an unauthorised person, Act 843, section 31 requires the controller to notify the Data Protection Commission and affected data subjects as soon as reasonably practicable (subject to any delay directed for a criminal investigation). As processor we will notify the affected Business and cooperate; the Business notifies its customers/Commission where it is controller." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="8. Your rights under Act 843" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="Subject to the Act and proof of identity, a data subject may:" FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Access: request confirmation/description of personal data held and access in an intelligible form (sections 32 and 35; a controller should normally comply promptly and within 40 days under section 35(10))." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Correction/deletion: request correction or deletion of inaccurate, irrelevant, excessive, out-of-date, incomplete, misleading or unlawfully obtained data, or deletion of a record the controller is no longer authorised to retain (section 33)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Object / stop processing: object under section 20, and by written notice require a controller to cease processing that causes or is likely to cause unwarranted damage or distress (section 39 — the controller must respond in writing within 21 days)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Direct marketing: require a controller not to process data for direct marketing; prior written consent is required for such use (section 40)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Automated decisions: rights in relation to decisions based solely on automated processing that significantly affect the person (section 41), where applicable — NeedleBase does not make such decisions about customers." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="•  Compensation/complaints: compensation may be available through the courts where damage or distress is caused by a contravention (section 43). You may also complain to the Data Protection Commission (which investigates complaints and maintains the Data Protection Register under Act 843, sections 3 and 46) via its website at dataprotection.org.gh / dpc.gov.gh, and ask the Commission for an assessment under section 77. Please contact the Business that collected your data first — it is usually the controller — and contact us at [contact email] if you need us, as processor, to assist that Business." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="Customers should normally direct requests to their tailoring Business (the controller). If you contact HelmutCode about customer data, we will pass the request to the relevant Business and assist it, unless we are the controller for that data (for example your Owner account)." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="9. Children" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="NeedleBase is a business tool. Personal accounts are for adults (18+) running or working in a Business. A Business should not enter a child&#x27;s personal data except where a parent/guardian has arranged a garment/order and only the minimum necessary should be recorded; Act 843, section 37 restricts processing of special personal data, including data relating to a child under parental control except as the Act provides." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="10. Registration and accountability" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="A data controller who intends to process personal data must register with the Data Protection Commission (Act 843, sections 27, 46 and 53; renewal every two years, section 50). HelmutCode&#x27;s registration status for processing it controls: [DPC registration status/number to be inserted]. Each Business is responsible for its own registration as controller of its customer data. A certified Data Protection Supervisor may be appointed where required or appropriate (section 58): [Data Protection Supervisor/contact if appointed, to be inserted]." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="11. Changes to this Policy" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="We may update this Policy as the Service or law changes, posting the new version with a new &quot;Last updated&quot; date and giving reasonable notice of material changes through the Service or by email." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Label Text="12. Contact" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" Margin="0,10,0,0" LineBreakMode="WordWrap" />
            <Label Text="HelmutCode, [registered address in Ghana], [contact email]. Data-protection contact: [contact email]. If you are a customer of a tailoring Business, please contact that Business first about its customer records." FontSize="14" TextColor="{StaticResource Gray600}" LineBreakMode="WordWrap" LineHeight="1.25" />
            <Button Text="Back" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource White}" CornerRadius="10" HeightRequest="48" FontAttributes="Bold" FontSize="16" Margin="0,16,0,0" Clicked="OnBackClicked" SemanticProperties.Description="Back to registration" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
