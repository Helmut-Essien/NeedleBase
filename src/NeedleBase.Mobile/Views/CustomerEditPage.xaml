<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             x:Class="NeedleBase.Mobile.Views.CustomerEditPage"
             x:DataType="vm:CustomerEditViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,20" Spacing="14">
            <Button Text="Back"
                    ImageSource="{mi:Material Icon=ArrowBack, IconColor={StaticResource Charcoal}}"
                    Command="{Binding GoBackCommand}"
                    IsEnabled="{Binding CanGoBack}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Charcoal}"
                    HorizontalOptions="Start"
                    HeightRequest="48"
                    Padding="0,0,12,0"
                    SemanticProperties.Description="Go back" />
            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Charcoal}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Name"
                   TextColor="{StaticResource Charcoal}" FontAttributes="Bold"
                   FontSize="14" />
            <Entry Text="{Binding Name}"
                   Placeholder="Efua Mensah"
                   PlaceholderColor="{StaticResource Gray600}"
                   TextColor="{StaticResource Charcoal}"
                   MaxLength="200"
                   HeightRequest="48"
                   BackgroundColor="White"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Customer name" />
            <Label Text="{Binding NameError}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasNameError}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   SemanticProperties.Description="Customer name error" />

            <Label Text="Phone"
                   TextColor="{StaticResource Charcoal}" FontAttributes="Bold"
                   FontSize="14" />
            <Entry Text="{Binding Phone}"
                   Placeholder="+233 24 555 0123"
                   PlaceholderColor="{StaticResource Gray600}"
                   TextColor="{StaticResource Charcoal}"
                   Keyboard="Telephone"
                   MaxLength="40"
                   HeightRequest="48"
                   BackgroundColor="White"
                   IsEnabled="{Binding CanSubmit}"
                   SemanticProperties.Description="Customer phone number" />
            <Label Text="{Binding PhoneError}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasPhoneError}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   SemanticProperties.Description="Customer phone error" />

            <Label Text="Notes (optional)"
                   TextColor="{StaticResource Charcoal}" FontAttributes="Bold"
                   FontSize="14" />
            <Editor Text="{Binding Notes}"
                    Placeholder="Preferences, reminders…"
                    PlaceholderColor="{StaticResource Gray600}"
                    TextColor="{StaticResource Charcoal}"
                    AutoSize="TextChanges"
                    MaxLength="2000"
                    BackgroundColor="White"
                    MinimumHeightRequest="80"
                    IsEnabled="{Binding CanSubmit}"
                    SemanticProperties.Description="Optional customer notes" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasError}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   SemanticProperties.Description="Save error" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Button Text="Save"
                    HeightRequest="48"
                    CornerRadius="10"
                    FontSize="16"
                    FontAttributes="Bold"
                    Command="{Binding SaveCommand}"
                    TextColor="White"
                    IsEnabled="{Binding CanSubmit}"
                    Margin="0,12,0,0"
                    SemanticProperties.Description="Save customer on this device" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
