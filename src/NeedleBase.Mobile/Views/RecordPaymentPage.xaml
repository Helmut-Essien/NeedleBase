<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:NeedleBase.Mobile.ViewModels"
             x:Class="NeedleBase.Mobile.Views.RecordPaymentPage"
             x:DataType="vm:RecordPaymentViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,24" Spacing="12">
            <Button Text="Back"
                    ImageSource="{mi:Material Icon=ArrowBack, IconColor={StaticResource Charcoal}}"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Charcoal}"
                    HorizontalOptions="Start"
                    HeightRequest="48"
                    Padding="0,0,12,0"
                    SemanticProperties.Description="Go back" />

            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Charcoal}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="{Binding PaidSummary}" FontSize="14" TextColor="{StaticResource Gray600}" />
            <Label Text="{Binding BalanceText}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding CanRecord}">
                <Label Text="Amount received (GH₵)" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Text="{Binding AmountText}"
                           Placeholder="200.00"
                           PlaceholderColor="{StaticResource Gray600}"
                           TextColor="{StaticResource Charcoal}"
                           Keyboard="Numeric"
                           MaxLength="14"
                           HeightRequest="48"
                           BackgroundColor="White"
                           IsEnabled="{Binding CanSubmit}"
                           SemanticProperties.Description="Amount received in Ghana cedis" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Text="Full balance"
                            Command="{Binding FillBalanceCommand}"
                            HeightRequest="48"
                            SemanticProperties.Description="Fill in the full balance left" />
                </Grid>
                <Label Text="{Binding AmountError}"
                       TextColor="{StaticResource SemanticError}"
                       IsVisible="{Binding HasAmountError}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       SemanticProperties.Description="Amount error" />

                <Label Text="How was it paid?" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <FlexLayout Wrap="Wrap"
                            RadioButtonGroup.GroupName="paymentMethod"
                            RadioButtonGroup.SelectedValue="{Binding Method}">
                    <RadioButton Content="Cash" Value="Cash" MinimumHeightRequest="48" Margin="0,0,12,0" TextColor="{StaticResource Charcoal}" />
                    <RadioButton Content="MoMo" Value="MoMo" MinimumHeightRequest="48" Margin="0,0,12,0" TextColor="{StaticResource Charcoal}" />
                    <RadioButton Content="Bank" Value="Bank" MinimumHeightRequest="48" Margin="0,0,12,0" TextColor="{StaticResource Charcoal}" />
                    <RadioButton Content="Other" Value="Other" MinimumHeightRequest="48" TextColor="{StaticResource Charcoal}" />
                </FlexLayout>

                <Label Text="Note (optional)" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                <Editor Text="{Binding Note}"
                        Placeholder="e.g. MoMo ref or who paid"
                        PlaceholderColor="{StaticResource Gray600}"
                        TextColor="{StaticResource Charcoal}"
                        AutoSize="TextChanges"
                        MaxLength="2000"
                        BackgroundColor="White"
                        MinimumHeightRequest="80"
                        IsEnabled="{Binding CanSubmit}"
                        SemanticProperties.Description="Optional payment note" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource SemanticError}"
                   IsVisible="{Binding HasError}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   SemanticProperties.Description="Payment error" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <Button Text="Save payment"
                    HeightRequest="48"
                    CornerRadius="10"
                    FontSize="16"
                    FontAttributes="Bold"
                    Command="{Binding SaveCommand}"
                    TextColor="White"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    IsEnabled="{Binding CanSubmit}"
                    IsVisible="{Binding CanRecord}"
                    Margin="0,12,0,0"
                    SemanticProperties.Description="Save payment on this device" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
