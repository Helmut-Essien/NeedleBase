<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NeedleBase.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:mci="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
    xmlns:views="clr-namespace:NeedleBase.Mobile.Views"
    Title="NeedleBase"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Sign in"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}"
        FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Title="Register"
        Route="RegisterPage"
        ContentTemplate="{DataTemplate views:RegisterPage}"
        FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Title="Reset password"
        Route="ForgotPasswordPage"
        ContentTemplate="{DataTemplate views:ForgotPasswordPage}"
        FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Title="Join your team"
        Route="AcceptInvitePage"
        ContentTemplate="{DataTemplate views:AcceptInvitePage}"
        FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False"
        Shell.NavBarIsVisible="False" />

    <TabBar Route="main"
            Shell.TabBarBackgroundColor="White"
            Shell.TabBarForegroundColor="{StaticResource Primary}"
            Shell.TabBarTitleColor="{StaticResource Primary}"
            Shell.TabBarUnselectedColor="{StaticResource Gray500}">
        <Tab Title="Home"
             Route="HomePage"
             mci:MauiIcon.Value="{mi:Material Icon=Home, IconSize=22, TargetName='.'}">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Customers"
             Route="CustomersPage"
             mci:MauiIcon.Value="{mi:Material Icon=People, IconSize=22, TargetName='.'}">
            <ShellContent ContentTemplate="{DataTemplate views:CustomersPage}" />
        </Tab>
        <Tab Title="Orders"
             Route="OrdersPage"
             mci:MauiIcon.Value="{mi:Material Icon=ReceiptLong, IconSize=22, TargetName='.'}">
            <ShellContent ContentTemplate="{DataTemplate views:OrdersPage}" />
        </Tab>
        <Tab x:Name="PaymentsTab"
             Title="Payments"
             Route="PaymentsPage"
             mci:MauiIcon.Value="{mi:Material Icon=Payments, IconSize=22, TargetName='.'}">
            <ShellContent ContentTemplate="{DataTemplate views:PaymentsPage}" />
        </Tab>
        <Tab Title="More"
             Route="MorePage"
             mci:MauiIcon.Value="{mi:Material Icon=Menu, IconSize=22, TargetName='.'}">
            <ShellContent ContentTemplate="{DataTemplate views:MorePage}" />
        </Tab>
    </TabBar>
</Shell>
