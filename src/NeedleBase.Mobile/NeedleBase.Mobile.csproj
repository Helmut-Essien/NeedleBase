<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net9.0 is a class-library TFM so unit tests can reference the app.
		     Android is the shipped platform for MVP. -->
		<TargetFrameworks>net9.0;net9.0-android</TargetFrameworks>

		<OutputType Condition="'$(TargetFramework)' == 'net9.0'">Library</OutputType>
		<OutputType Condition="'$(TargetFramework)' != 'net9.0'">Exe</OutputType>
		<RootNamespace>NeedleBase.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>NeedleBase</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.helmutcode.needlebase</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<!-- net9.0 is a test/library TFM only; platform APIs (CommunityToolkit.Maui) ship on android. -->
		<NoWarn Condition="'$(TargetFramework)' == 'net9.0'">$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<!-- Release API base URL (G10). PLACEHOLDER: the .invalid domain never resolves, so a
	     Release build that was not given a real URL fails visibly instead of calling a
	     wrong host. Set it at build time, e.g.
	     dotnet publish -f net9.0-android -c Release -p:NeedleBaseReleaseApiBaseUrl=https://YOUR-API-HOST/
	     Debug builds ignore this and keep the localhost/adb-reverse behaviour. -->
	<PropertyGroup>
		<NeedleBaseReleaseApiBaseUrl Condition="'$(NeedleBaseReleaseApiBaseUrl)' == ''">https://api.needlebase-placeholder.invalid/</NeedleBaseReleaseApiBaseUrl>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyMetadata Include="NeedleBaseReleaseApiBaseUrl" Value="$(NeedleBaseReleaseApiBaseUrl)" />
	</ItemGroup>


	<ItemGroup>
		<!-- App Icon Color="#FFFFFF"-->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg"  />

		<!-- Splash Screen (dark canvas + logo, AssetTag pattern) -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1a1a1a" BaseSize="384,384" />


		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Material" Version="5.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="11.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NeedleBase.Application\NeedleBase.Application.csproj" />
		<ProjectReference Include="..\NeedleBase.Mobile.Data\NeedleBase.Mobile.Data.csproj" />
	</ItemGroup>

</Project>
