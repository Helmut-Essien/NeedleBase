<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NeedleBase.Api</RootNamespace>
    <UserSecretsId>needlebase-api-dev-secrets</UserSecretsId>
    <!-- Shared hosting (MonsterASP free: 256 MB per website): workstation GC keeps the heap small;
         these apps serve small shops, so server GC's throughput is not needed. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The Web references this project and hosts the Api in its own process on the production site (docs/deployment.md).
       The Api's appsettings*.json must not flow into the Web's output/publish folder (the Web's appsettings.json holds
       the merged settings there). Running the Api on its own (dotnet run, integration tests) reads them from this
       project folder (content root), so nothing is lost. -->
  <ItemGroup>
    <Content Update="appsettings*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeedleBase.Application\NeedleBase.Application.csproj" />
    <ProjectReference Include="..\NeedleBase.Infrastructure\NeedleBase.Infrastructure.csproj" />
  </ItemGroup>

</Project>
